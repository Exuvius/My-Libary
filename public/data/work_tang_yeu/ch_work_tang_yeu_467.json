{"sentences":[{"id":"s_work_tang_yeu_467_1","chapterId":"ch_work_tang_yeu_467","text":"菩提資糧論大科","sortOrder":1},{"id":"s_work_tang_yeu_467_2","chapterId":"ch_work_tang_yeu_467","text":"┌說論緣起","sortOrder":2},{"id":"s_work_tang_yeu_467_3","chapterId":"ch_work_tang_yeu_467","text":"├資糧法體┬正取六度┬般若爲初資糧","sortOrder":3},{"id":"s_work_tang_yeu_467_4","chapterId":"ch_work_tang_yeu_467","text":"││├餘度爲次資糧┬施等五","sortOrder":4},{"id":"s_work_tang_yeu_467_5","chapterId":"ch_work_tang_yeu_467","text":"│││└般若所攝方便等四","sortOrder":5},{"id":"s_work_tang_yeu_467_6","chapterId":"ch_work_tang_yeu_467","text":"││└六度總攝一切","sortOrder":6},{"id":"s_work_tang_yeu_467_7","chapterId":"ch_work_tang_yeu_467","text":"│└旁通餘義┬四處┌五乘方便攝受衆生","sortOrder":7},{"id":"s_work_tang_yeu_467_8","chapterId":"ch_work_tang_yeu_467","text":"│　└四無量┬慈等三　├世出世間捨離法執","sortOrder":8},{"id":"s_work_tang_yeu_467_9","chapterId":"ch_work_tang_yeu_467","text":"│　└捨───┴未得不退不廢精進","sortOrder":9},{"id":"s_work_tang_yeu_467_10","chapterId":"ch_work_tang_yeu_467","text":"├資糧修集┬初番以福慧辨┬福聚┬入地修","sortOrder":10},{"id":"s_work_tang_yeu_467_11","chapterId":"ch_work_tang_yeu_467","text":"│││└初業修┬懺悔等成福方便","sortOrder":11},{"id":"s_work_tang_yeu_467_12","chapterId":"ch_work_tang_yeu_467","text":"│││└尊他等護福方便","sortOrder":12},{"id":"s_work_tang_yeu_467_13","chapterId":"ch_work_tang_yeu_467","text":"││└聚慈─┬勝義修三解脫門","sortOrder":13},{"id":"s_work_tang_yeu_467_14","chapterId":"ch_work_tang_yeu_467","text":"││├方便不墮涅槃","sortOrder":14},{"id":"s_work_tang_yeu_467_15","chapterId":"ch_work_tang_yeu_467","text":"││└不以斷滅滅惑","sortOrder":15},{"id":"s_work_tang_yeu_467_16","chapterId":"ch_work_tang_yeu_467","text":"│└次番以位地辨┬得力者修","sortOrder":16},{"id":"s_work_tang_yeu_467_17","chapterId":"ch_work_tang_yeu_467","text":"│　└未得力者修┬戒行","sortOrder":17},{"id":"s_work_tang_yeu_467_18","chapterId":"ch_work_tang_yeu_467","text":"│　├定行","sortOrder":18},{"id":"s_work_tang_yeu_467_19","chapterId":"ch_work_tang_yeu_467","text":"│　├修相行","sortOrder":19},{"id":"s_work_tang_yeu_467_20","chapterId":"ch_work_tang_yeu_467","text":"│　├法行","sortOrder":20},{"id":"s_work_tang_yeu_467_21","chapterId":"ch_work_tang_yeu_467","text":"│　├教授行","sortOrder":21},{"id":"s_work_tang_yeu_467_22","chapterId":"ch_work_tang_yeu_467","text":"│　└法供養行","sortOrder":22},{"id":"s_work_tang_yeu_467_23","chapterId":"ch_work_tang_yeu_467","text":"└總結說意","sortOrder":23}],"overrides":{}}