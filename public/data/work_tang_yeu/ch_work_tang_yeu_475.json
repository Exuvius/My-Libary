{"sentences":[{"id":"s_work_tang_yeu_475_1","chapterId":"ch_work_tang_yeu_475","text":"顯揚聖教論大科","sortOrder":1},{"id":"s_work_tang_yeu_475_2","chapterId":"ch_work_tang_yeu_475","text":"┌總敍緣起─────────────────┐","sortOrder":2},{"id":"s_work_tang_yeu_475_3","chapterId":"ch_work_tang_yeu_475","text":"├正明瑜伽┬一聞持┬知法九事────────┴攝事品一","sortOrder":3},{"id":"s_work_tang_yeu_475_4","chapterId":"ch_work_tang_yeu_475","text":"││　└知義四相─────────攝淨義品二","sortOrder":4},{"id":"s_work_tang_yeu_475_5","chapterId":"ch_work_tang_yeu_475","text":"│├二修行┬先成所緣─────────成善巧品三","sortOrder":5},{"id":"s_work_tang_yeu_475_6","chapterId":"ch_work_tang_yeu_475","text":"││　├次成加行┬初無常遍知───成無常品四","sortOrder":6},{"id":"s_work_tang_yeu_475_7","chapterId":"ch_work_tang_yeu_475","text":"││　│├次苦遍知────成苦品五","sortOrder":7},{"id":"s_work_tang_yeu_475_8","chapterId":"ch_work_tang_yeu_475","text":"││　│├三空遍知────成空品六","sortOrder":8},{"id":"s_work_tang_yeu_475_9","chapterId":"ch_work_tang_yeu_475","text":"││　│└四無性遍知───成無性品七","sortOrder":9},{"id":"s_work_tang_yeu_475_10","chapterId":"ch_work_tang_yeu_475","text":"││　└後成趣入┬果現觀─────成現觀品八","sortOrder":10},{"id":"s_work_tang_yeu_475_11","chapterId":"ch_work_tang_yeu_475","text":"││└因瑜伽─────成瑜伽品九","sortOrder":11},{"id":"s_work_tang_yeu_475_12","chapterId":"ch_work_tang_yeu_475","text":"│└三思擇┬先簡不思議────────成不思議品十","sortOrder":12},{"id":"s_work_tang_yeu_475_13","chapterId":"ch_work_tang_yeu_475","text":"│└後最勝決擇───────┬攝勝決擇品十一","sortOrder":13},{"id":"s_work_tang_yeu_475_14","chapterId":"ch_work_tang_yeu_475","text":"└結歸五地─────────────────┘","sortOrder":14}],"overrides":{}}