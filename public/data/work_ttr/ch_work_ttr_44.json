{"sentences":[{"id":"s_work_ttr_44_1","chapterId":"ch_work_ttr_44","textTraditional":"【經】","sentenceOrder":1},{"id":"s_work_ttr_44_2","chapterId":"ch_work_ttr_44","textTraditional":"十有五年春，齊侯、宋公、陳侯、衛侯、鄭伯會于鄄。","sentenceOrder":2},{"id":"s_work_ttr_44_3","chapterId":"ch_work_ttr_44","textTraditional":"夏，夫人姜氏如齊。","sentenceOrder":3},{"id":"s_work_ttr_44_4","chapterId":"ch_work_ttr_44","textTraditional":"秋，宋人、齊人、邾人伐郳。","sentenceOrder":4},{"id":"s_work_ttr_44_5","chapterId":"ch_work_ttr_44","textTraditional":"鄭人侵宋。","sentenceOrder":5},{"id":"s_work_ttr_44_6","chapterId":"ch_work_ttr_44","textTraditional":"冬十月。","sentenceOrder":6},{"id":"s_work_ttr_44_7","chapterId":"ch_work_ttr_44","textTraditional":"【傳】","sentenceOrder":7},{"id":"s_work_ttr_44_8","chapterId":"ch_work_ttr_44","textTraditional":"十五年春，復會焉，齊始霸也。","sentenceOrder":8},{"id":"s_work_ttr_44_9","chapterId":"ch_work_ttr_44","textTraditional":"秋，諸侯為宋伐郳。鄭人間之而侵宋。","sentenceOrder":9}],"overrides":{}}