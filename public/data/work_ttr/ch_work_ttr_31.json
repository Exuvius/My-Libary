{"sentences":[{"id":"s_work_ttr_31_1","chapterId":"ch_work_ttr_31","textTraditional":"【經】","sentenceOrder":1},{"id":"s_work_ttr_31_2","chapterId":"ch_work_ttr_31","textTraditional":"二年春王二月，葬陳莊公。","sentenceOrder":2},{"id":"s_work_ttr_31_3","chapterId":"ch_work_ttr_31","textTraditional":"夏，公子慶父帥師伐於餘丘。","sentenceOrder":3},{"id":"s_work_ttr_31_4","chapterId":"ch_work_ttr_31","textTraditional":"秋七月，齊王姬卒。","sentenceOrder":4},{"id":"s_work_ttr_31_5","chapterId":"ch_work_ttr_31","textTraditional":"冬十有二月，夫人姜氏會齊侯于禚。","sentenceOrder":5},{"id":"s_work_ttr_31_6","chapterId":"ch_work_ttr_31","textTraditional":"乙酉，宋公馮卒。","sentenceOrder":6},{"id":"s_work_ttr_31_7","chapterId":"ch_work_ttr_31","textTraditional":"【傳】","sentenceOrder":7},{"id":"s_work_ttr_31_8","chapterId":"ch_work_ttr_31","textTraditional":"二年冬，夫人姜氏會齊侯于禚。書，姦也。","sentenceOrder":8}],"overrides":{}}