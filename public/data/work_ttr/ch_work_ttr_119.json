{"sentences":[{"id":"s_work_ttr_119_1","chapterId":"ch_work_ttr_119","textTraditional":"【經】","sentenceOrder":1},{"id":"s_work_ttr_119_2","chapterId":"ch_work_ttr_119","textTraditional":"五年春，公如齊。","sentenceOrder":2},{"id":"s_work_ttr_119_3","chapterId":"ch_work_ttr_119","textTraditional":"夏，公至自齊。","sentenceOrder":3},{"id":"s_work_ttr_119_4","chapterId":"ch_work_ttr_119","textTraditional":"秋九月，齊高固來逆叔姬。","sentenceOrder":4},{"id":"s_work_ttr_119_5","chapterId":"ch_work_ttr_119","textTraditional":"叔孫得臣卒。","sentenceOrder":5},{"id":"s_work_ttr_119_6","chapterId":"ch_work_ttr_119","textTraditional":"冬，齊高固及子叔姬來。","sentenceOrder":6},{"id":"s_work_ttr_119_7","chapterId":"ch_work_ttr_119","textTraditional":"楚人伐鄭。","sentenceOrder":7},{"id":"s_work_ttr_119_8","chapterId":"ch_work_ttr_119","textTraditional":"【傳】","sentenceOrder":8},{"id":"s_work_ttr_119_9","chapterId":"ch_work_ttr_119","textTraditional":"五年春，公如齊，高固使齊侯止公，請叔姬焉。","sentenceOrder":9},{"id":"s_work_ttr_119_10","chapterId":"ch_work_ttr_119","textTraditional":"夏，公至自齊，書，過也。","sentenceOrder":10},{"id":"s_work_ttr_119_11","chapterId":"ch_work_ttr_119","textTraditional":"秋九月，齊高固來逆女，自為也。故書曰「逆叔姬」，卿自逆也。","sentenceOrder":11},{"id":"s_work_ttr_119_12","chapterId":"ch_work_ttr_119","textTraditional":"冬，來，反馬也。","sentenceOrder":12},{"id":"s_work_ttr_119_13","chapterId":"ch_work_ttr_119","textTraditional":"楚子伐鄭，陳及楚平。晉荀林父救鄭，伐陳。","sentenceOrder":13}],"overrides":{}}