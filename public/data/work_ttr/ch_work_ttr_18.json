{"sentences":[{"id":"s_work_ttr_18_1","chapterId":"ch_work_ttr_18","textTraditional":"【經】","sentenceOrder":1},{"id":"s_work_ttr_18_2","chapterId":"ch_work_ttr_18","textTraditional":"七年春二月己亥，焚咸丘。","sentenceOrder":2},{"id":"s_work_ttr_18_3","chapterId":"ch_work_ttr_18","textTraditional":"夏，穀伯綏來朝。鄧侯吾離來朝。","sentenceOrder":3},{"id":"s_work_ttr_18_4","chapterId":"ch_work_ttr_18","textTraditional":"【傳】","sentenceOrder":4},{"id":"s_work_ttr_18_5","chapterId":"ch_work_ttr_18","textTraditional":"七年春，穀伯、鄧侯來朝。名，賤之也。","sentenceOrder":5},{"id":"s_work_ttr_18_6","chapterId":"ch_work_ttr_18","textTraditional":"夏，盟、向求成于鄭，既而背之。","sentenceOrder":6},{"id":"s_work_ttr_18_7","chapterId":"ch_work_ttr_18","textTraditional":"秋，鄭人、齊人、衛人伐盟、向。王遷盟、向之民于郟。","sentenceOrder":7},{"id":"s_work_ttr_18_8","chapterId":"ch_work_ttr_18","textTraditional":"冬，曲沃伯誘晉小子侯，殺之。","sentenceOrder":8}],"overrides":{}}