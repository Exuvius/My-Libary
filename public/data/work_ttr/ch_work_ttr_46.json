{"sentences":[{"id":"s_work_ttr_46_1","chapterId":"ch_work_ttr_46","textTraditional":"【經】","sentenceOrder":1},{"id":"s_work_ttr_46_2","chapterId":"ch_work_ttr_46","textTraditional":"十有七年春，齊人執鄭詹。","sentenceOrder":2},{"id":"s_work_ttr_46_3","chapterId":"ch_work_ttr_46","textTraditional":"夏，齊人殲于遂。","sentenceOrder":3},{"id":"s_work_ttr_46_4","chapterId":"ch_work_ttr_46","textTraditional":"秋，鄭詹自齊逃來。","sentenceOrder":4},{"id":"s_work_ttr_46_5","chapterId":"ch_work_ttr_46","textTraditional":"冬，多麋。","sentenceOrder":5},{"id":"s_work_ttr_46_6","chapterId":"ch_work_ttr_46","textTraditional":"【傳】","sentenceOrder":6},{"id":"s_work_ttr_46_7","chapterId":"ch_work_ttr_46","textTraditional":"十七年春，齊人執鄭詹，鄭不朝也。","sentenceOrder":7},{"id":"s_work_ttr_46_8","chapterId":"ch_work_ttr_46","textTraditional":"夏，遂因氏，頜氏、工婁氏、須遂氏饗齊戍，醉而殺之，齊人殲焉。","sentenceOrder":8}],"overrides":{}}