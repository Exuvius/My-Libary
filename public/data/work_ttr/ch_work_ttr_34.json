{"sentences":[{"id":"s_work_ttr_34_1","chapterId":"ch_work_ttr_34","textTraditional":"【經】","sentenceOrder":1},{"id":"s_work_ttr_34_2","chapterId":"ch_work_ttr_34","textTraditional":"五年春王正月。","sentenceOrder":2},{"id":"s_work_ttr_34_3","chapterId":"ch_work_ttr_34","textTraditional":"夏，夫人姜氏如齊師。","sentenceOrder":3},{"id":"s_work_ttr_34_4","chapterId":"ch_work_ttr_34","textTraditional":"秋，郳犁來來朝。","sentenceOrder":4},{"id":"s_work_ttr_34_5","chapterId":"ch_work_ttr_34","textTraditional":"冬，公會齊人、宋人、陳人、蔡人伐衛。","sentenceOrder":5},{"id":"s_work_ttr_34_6","chapterId":"ch_work_ttr_34","textTraditional":"【傳】","sentenceOrder":6},{"id":"s_work_ttr_34_7","chapterId":"ch_work_ttr_34","textTraditional":"五年秋，郳犁來來朝，名，未王命也。","sentenceOrder":7},{"id":"s_work_ttr_34_8","chapterId":"ch_work_ttr_34","textTraditional":"冬，伐衛，納惠公也。","sentenceOrder":8}],"overrides":{}}