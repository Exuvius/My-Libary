{"sentences":[{"id":"s_work_ttr_55_1","chapterId":"ch_work_ttr_55","textTraditional":"【經】","sentenceOrder":1},{"id":"s_work_ttr_55_2","chapterId":"ch_work_ttr_55","textTraditional":"二十有六年春，公伐戎。","sentenceOrder":2},{"id":"s_work_ttr_55_3","chapterId":"ch_work_ttr_55","textTraditional":"夏，公至自伐戎。","sentenceOrder":3},{"id":"s_work_ttr_55_4","chapterId":"ch_work_ttr_55","textTraditional":"曹殺其大夫。","sentenceOrder":4},{"id":"s_work_ttr_55_5","chapterId":"ch_work_ttr_55","textTraditional":"秋，公會宋人、齊人，伐徐。","sentenceOrder":5},{"id":"s_work_ttr_55_6","chapterId":"ch_work_ttr_55","textTraditional":"冬十有二月癸亥，朔，日有食之。","sentenceOrder":6},{"id":"s_work_ttr_55_7","chapterId":"ch_work_ttr_55","textTraditional":"【傳】","sentenceOrder":7},{"id":"s_work_ttr_55_8","chapterId":"ch_work_ttr_55","textTraditional":"二十六年春，晉士蒍為大司空。","sentenceOrder":8},{"id":"s_work_ttr_55_9","chapterId":"ch_work_ttr_55","textTraditional":"夏，士蒍城絳，以深其宮。","sentenceOrder":9},{"id":"s_work_ttr_55_10","chapterId":"ch_work_ttr_55","textTraditional":"秋，虢人侵晉。冬，虢人又侵晉。","sentenceOrder":10}],"overrides":{}}