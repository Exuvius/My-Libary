{"sentences":[{"id":"s_work_ttr_15_1","chapterId":"ch_work_ttr_15","textTraditional":"【經】","sentenceOrder":1},{"id":"s_work_ttr_15_2","chapterId":"ch_work_ttr_15","textTraditional":"四年春正月，公狩于郎。","sentenceOrder":2},{"id":"s_work_ttr_15_3","chapterId":"ch_work_ttr_15","textTraditional":"夏，天王使宰渠伯糾來聘。","sentenceOrder":3},{"id":"s_work_ttr_15_4","chapterId":"ch_work_ttr_15","textTraditional":"【傳】","sentenceOrder":4},{"id":"s_work_ttr_15_5","chapterId":"ch_work_ttr_15","textTraditional":"四年春正月，公狩于郎。書，時，禮也。","sentenceOrder":5},{"id":"s_work_ttr_15_6","chapterId":"ch_work_ttr_15","textTraditional":"夏，周宰渠伯糾來聘。父在，故名。","sentenceOrder":6},{"id":"s_work_ttr_15_7","chapterId":"ch_work_ttr_15","textTraditional":"秋，秦師侵芮，敗焉，小之也。","sentenceOrder":7},{"id":"s_work_ttr_15_8","chapterId":"ch_work_ttr_15","textTraditional":"冬，王師、秦師圍魏，執芮伯以歸。","sentenceOrder":8}],"overrides":{}}