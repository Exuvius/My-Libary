{"sentences":[{"id":"s_work_cdt_95_1","chapterId":"ch_work_cdt_95","textTraditional":"一、三十有二年，春王正月。","sentenceOrder":1},{"id":"s_work_cdt_95_2","chapterId":"ch_work_cdt_95","textTraditional":"二、夏四月己丑，鄭伯接卒。","sentenceOrder":2},{"id":"s_work_cdt_95_3","chapterId":"ch_work_cdt_95","textTraditional":"三、衞人侵狄。","sentenceOrder":3},{"id":"s_work_cdt_95_4","chapterId":"ch_work_cdt_95","textTraditional":"四、秋，衞人及狄盟。","sentenceOrder":4},{"id":"s_work_cdt_95_5","chapterId":"ch_work_cdt_95","textTraditional":"五、冬十有二月己卯，晉侯重耳卒。","sentenceOrder":5}],"overrides":{}}