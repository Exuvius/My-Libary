{"sentences":[{"id":"s_work_cdt_177_1","chapterId":"ch_work_cdt_177","textTraditional":"一、二十有八年。春，無冰。","sentenceOrder":1},{"id":"s_work_cdt_177_2","chapterId":"ch_work_cdt_177","textTraditional":"二、夏，衞石惡出奔晉。","sentenceOrder":2},{"id":"s_work_cdt_177_3","chapterId":"ch_work_cdt_177","textTraditional":"三、邾婁子來朝。","sentenceOrder":3},{"id":"s_work_cdt_177_4","chapterId":"ch_work_cdt_177","textTraditional":"四、秋八月，大雩。仲孫羯如晉。","sentenceOrder":4},{"id":"s_work_cdt_177_5","chapterId":"ch_work_cdt_177","textTraditional":"五、冬，齊慶封來奔。","sentenceOrder":5},{"id":"s_work_cdt_177_6","chapterId":"ch_work_cdt_177","textTraditional":"六、十有一月，公如楚。","sentenceOrder":6},{"id":"s_work_cdt_177_7","chapterId":"ch_work_cdt_177","textTraditional":"七、十有二月甲寅，天王崩。","sentenceOrder":7},{"id":"s_work_cdt_177_8","chapterId":"ch_work_cdt_177","textTraditional":"八、乙未，楚子昭卒。","sentenceOrder":8}],"overrides":{}}