{"sentences":[{"id":"s_work_cdt_219_1","chapterId":"ch_work_cdt_219","textTraditional":"一、七年。春王正月。","sentenceOrder":1},{"id":"s_work_cdt_219_2","chapterId":"ch_work_cdt_219","textTraditional":"二、夏四月。","sentenceOrder":2},{"id":"s_work_cdt_219_3","chapterId":"ch_work_cdt_219","textTraditional":"三、秋，齊侯、鄭伯盟于鹹。","sentenceOrder":3},{"id":"s_work_cdt_219_4","chapterId":"ch_work_cdt_219","textTraditional":"四、齊人執衞行人北宮結以侵衞。","sentenceOrder":4},{"id":"s_work_cdt_219_5","chapterId":"ch_work_cdt_219","textTraditional":"五、齊侯、衞侯盟于沙澤。","sentenceOrder":5},{"id":"s_work_cdt_219_6","chapterId":"ch_work_cdt_219","textTraditional":"六、大雩。","sentenceOrder":6},{"id":"s_work_cdt_219_7","chapterId":"ch_work_cdt_219","textTraditional":"七、齊國夏帥師伐我西鄙。","sentenceOrder":7},{"id":"s_work_cdt_219_8","chapterId":"ch_work_cdt_219","textTraditional":"八、九月，大雩。","sentenceOrder":8},{"id":"s_work_cdt_219_9","chapterId":"ch_work_cdt_219","textTraditional":"九、冬十月。","sentenceOrder":9}],"overrides":{}}