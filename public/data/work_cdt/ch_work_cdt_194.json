{"sentences":[{"id":"s_work_cdt_194_1","chapterId":"ch_work_cdt_194","textTraditional":"一、十有四年。春，隱如至自晉。","sentenceOrder":1},{"id":"s_work_cdt_194_2","chapterId":"ch_work_cdt_194","textTraditional":"二、三月，曹伯滕卒。","sentenceOrder":2},{"id":"s_work_cdt_194_3","chapterId":"ch_work_cdt_194","textTraditional":"三、夏四月。","sentenceOrder":3},{"id":"s_work_cdt_194_4","chapterId":"ch_work_cdt_194","textTraditional":"四、秋，葬曹武公。","sentenceOrder":4},{"id":"s_work_cdt_194_5","chapterId":"ch_work_cdt_194","textTraditional":"五、八月，莒子去疾卒。","sentenceOrder":5},{"id":"s_work_cdt_194_6","chapterId":"ch_work_cdt_194","textTraditional":"六、冬，莒殺其公子意恢。","sentenceOrder":6}],"overrides":{}}