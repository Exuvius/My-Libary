{"sentences":[{"id":"s_work_cdt_44_1","chapterId":"ch_work_cdt_44","textTraditional":"一、十有五年，春，齊侯、宋公、陳侯、衞侯、鄭伯會于鄄。","sentenceOrder":1},{"id":"s_work_cdt_44_2","chapterId":"ch_work_cdt_44","textTraditional":"二、夏，夫人姜氏如齊。","sentenceOrder":2},{"id":"s_work_cdt_44_3","chapterId":"ch_work_cdt_44","textTraditional":"三、秋，宋人、齊人、邾婁人伐兒。","sentenceOrder":3},{"id":"s_work_cdt_44_4","chapterId":"ch_work_cdt_44","textTraditional":"四、鄭人侵宋。","sentenceOrder":4},{"id":"s_work_cdt_44_5","chapterId":"ch_work_cdt_44","textTraditional":"五、冬十月。","sentenceOrder":5}],"overrides":{}}