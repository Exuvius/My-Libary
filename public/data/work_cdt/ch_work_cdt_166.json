{"sentences":[{"id":"s_work_cdt_166_1","chapterId":"ch_work_cdt_166","textTraditional":"一、十有七年。春王二月庚午，邾婁子瞷卒。","sentenceOrder":1},{"id":"s_work_cdt_166_2","chapterId":"ch_work_cdt_166","textTraditional":"二、宋人伐陳。","sentenceOrder":2},{"id":"s_work_cdt_166_3","chapterId":"ch_work_cdt_166","textTraditional":"三、夏，衞石買帥師伐曹。","sentenceOrder":3},{"id":"s_work_cdt_166_4","chapterId":"ch_work_cdt_166","textTraditional":"四、秋，齊侯伐我北鄙，圍洮。","sentenceOrder":4},{"id":"s_work_cdt_166_5","chapterId":"ch_work_cdt_166","textTraditional":"五、齊高厚帥師伐我北鄙，圍防。","sentenceOrder":5},{"id":"s_work_cdt_166_6","chapterId":"ch_work_cdt_166","textTraditional":"六、九月，大雩。","sentenceOrder":6},{"id":"s_work_cdt_166_7","chapterId":"ch_work_cdt_166","textTraditional":"七、宋華臣出奔陳。","sentenceOrder":7},{"id":"s_work_cdt_166_8","chapterId":"ch_work_cdt_166","textTraditional":"八、冬，邾婁人伐我南鄙。","sentenceOrder":8}],"overrides":{}}