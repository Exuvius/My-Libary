{"sentences":[{"id":"s_work_cdt_187_1","chapterId":"ch_work_cdt_187","textTraditional":"一、七年。春王正月，暨齊平。","sentenceOrder":1},{"id":"s_work_cdt_187_2","chapterId":"ch_work_cdt_187","textTraditional":"二、三月，公如楚。","sentenceOrder":2},{"id":"s_work_cdt_187_3","chapterId":"ch_work_cdt_187","textTraditional":"三、叔孫舍如齊莅盟。","sentenceOrder":3},{"id":"s_work_cdt_187_4","chapterId":"ch_work_cdt_187","textTraditional":"四、夏四月甲辰朔，日有食之。","sentenceOrder":4},{"id":"s_work_cdt_187_5","chapterId":"ch_work_cdt_187","textTraditional":"五、秋八月戊辰，衞侯惡卒。","sentenceOrder":5},{"id":"s_work_cdt_187_6","chapterId":"ch_work_cdt_187","textTraditional":"六、九月，公至自楚。","sentenceOrder":6},{"id":"s_work_cdt_187_7","chapterId":"ch_work_cdt_187","textTraditional":"七、冬十有一月癸未，季孫宿卒。","sentenceOrder":7},{"id":"s_work_cdt_187_8","chapterId":"ch_work_cdt_187","textTraditional":"八、十有二月癸亥，葬衞襄公。","sentenceOrder":8}],"overrides":{}}