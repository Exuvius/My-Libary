{"sentences":[{"id":"s_work_cdt_50_1","chapterId":"ch_work_cdt_50","textTraditional":"一、二十有一年，春王正月。","sentenceOrder":1},{"id":"s_work_cdt_50_2","chapterId":"ch_work_cdt_50","textTraditional":"二、夏五月，辛酉，鄭伯突卒。","sentenceOrder":2},{"id":"s_work_cdt_50_3","chapterId":"ch_work_cdt_50","textTraditional":"三、秋七月戊戌，夫人姜氏薨。","sentenceOrder":3},{"id":"s_work_cdt_50_4","chapterId":"ch_work_cdt_50","textTraditional":"四、冬十有二月，葬鄭厲公。","sentenceOrder":4}],"overrides":{}}