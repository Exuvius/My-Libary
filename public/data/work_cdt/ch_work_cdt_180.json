{"sentences":[{"id":"s_work_cdt_180_1","chapterId":"ch_work_cdt_180","textTraditional":"一、三十有一年。春王正月。","sentenceOrder":1},{"id":"s_work_cdt_180_2","chapterId":"ch_work_cdt_180","textTraditional":"二、夏六月辛巳，公薨于楚宮。","sentenceOrder":2},{"id":"s_work_cdt_180_3","chapterId":"ch_work_cdt_180","textTraditional":"三、秋九月癸巳，子野卒。","sentenceOrder":3},{"id":"s_work_cdt_180_4","chapterId":"ch_work_cdt_180","textTraditional":"四、己亥，仲孫羯卒。","sentenceOrder":4},{"id":"s_work_cdt_180_5","chapterId":"ch_work_cdt_180","textTraditional":"五、冬十月，滕子來會葬。","sentenceOrder":5},{"id":"s_work_cdt_180_6","chapterId":"ch_work_cdt_180","textTraditional":"六、癸酉，葬我君襄公。","sentenceOrder":6},{"id":"s_work_cdt_180_7","chapterId":"ch_work_cdt_180","textTraditional":"七、十有一月，莒人弒其君密州。","sentenceOrder":7}],"overrides":{}}