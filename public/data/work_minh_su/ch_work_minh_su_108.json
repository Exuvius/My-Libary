der":184},{"id":"s_work_minh_su_108_185","chapterId":"ch_work_minh_su_108","textTraditional":"王偉","sentenceOrder":185},{"id":"s_work_minh_su_108_186","chapterId":"ch_work_minh_su_108","textTraditional":"端皇后父。萬曆五年封。","sentenceOrder":186},{"id":"s_work_minh_su_108_187","chapterId":"ch_work_minh_su_108","textTraditional":"萬曆中襲。三十四年七月丁亥卒。","sentenceOrder":187},{"id":"s_work_minh_su_108_188","chapterId":"ch_work_minh_su_108","textTraditional":"明輔","sentenceOrder":188},{"id":"s_work_minh_su_108_189","chapterId":"ch_work_minh_su_108","textTraditional":"萬曆三十五年正月辛未襲。","sentenceOrder":189},{"id":"s_work_minh_su_108_190","chapterId":"ch_work_minh_su_108","textTraditional":"永寧伯","sentenceOrder":190},{"id":"s_work_minh_su_108_191","chapterId":"ch_work_minh_su_108","textTraditional":"王天瑞","sentenceOrder":191},{"id":"s_work_minh_su_108_192","chapterId":"ch_work_minh_su_108","textTraditional":"光宗母孝靖太后父。光宗即位封。崇禎十四年卒。","sentenceOrder":192},{"id":"s_work_minh_su_108_193","chapterId":"ch_work_minh_su_108","textTraditional":"長錫","sentenceOrder":193},{"id":"s_work_minh_su_108_194","chapterId":"ch_work_minh_su_108","textTraditional":"崇禎十四年襲。","sentenceOrder":194},{"id":"s_work_minh_su_108_195","chapterId":"ch_work_minh_su_108","textTraditional":"博平侯","sentenceOrder":195},{"id":"s_work_minh_su_108_196","chapterId":"ch_work_minh_su_108","textTraditional":"郭維城","sentenceOrder":196},{"id":"s_work_minh_su_108_197","chapterId":"ch_work_minh_su_108","textTraditional":"光宗孝元皇后父。泰昌元年九月癸丑封伯。天啟元年閏二月進封侯。","sentenceOrder":197},{"id":"s_work_minh_su_108_198","chapterId":"ch_work_minh_su_108","textTraditional":"振明","sentenceOrder":198},{"id":"s_work_minh_su_108_199","chapterId":"ch_work_minh_su_108","textTraditional":"天啟元年閏二月丙戌封博平伯。","sentenceOrder":199},{"id":"s_work_minh_su_108_200","chapterId":"ch_work_minh_su_108","textTraditional":"新城侯","sentenceOrder":200},{"id":"s_work_minh_su_108_201","chapterId":"ch_work_minh_su_108","textTraditional":"王昇","sentenceOrder":201},{"id":"s_work_minh_su_108_202","chapterId":"ch_work_minh_su_108","textTraditional":"熹宗母孝和太后弟。天啟元年閏二月封伯，尋進侯。崇禎八年卒。","sentenceOrder":202},{"id":"s_work_minh_su_108_203","chapterId":"ch_work_minh_su_108","textTraditional":"國興","sentenceOrder":203},{"id":"s_work_minh_su_108_204","chapterId":"ch_work_minh_su_108","textTraditional":"崇禎九年十二月戊寅襲。死於賊。","sentenceOrder":204},{"id":"s_work_minh_su_108_205","chapterId":"ch_work_minh_su_108","textTraditional":"太康侯","sentenceOrder":205},{"id":"s_work_minh_su_108_206","chapterId":"ch_work_minh_su_108","textTraditional":"張國紀","sentenceOrder":206},{"id":"s_work_minh_su_108_207","chapterId":"ch_work_minh_su_108","textTraditional":"熹宗后父。天啟元年封伯。崇禎十一年十一月進封侯。死於賊。","sentenceOrder":207},{"id":"s_work_minh_su_108_208","chapterId":"ch_work_minh_su_108","textTraditional":"寧國公","sentenceOrder":208},{"id":"s_work_minh_su_108_209","chapterId":"ch_work_minh_su_108","textTraditional":"魏良卿","sentenceOrder":209},{"id":"s_work_minh_su_108_210","chapterId":"ch_work_minh_su_108","textTraditional":"內臣魏忠賢姪。天啟六年三月封肅寧伯，進侯。十月戊申進封公。七年八月丙申加太師。莊烈帝即位，伏誅。","sentenceOrder":210},{"id":"s_work_minh_su_108_211","chapterId":"ch_work_minh_su_108","textTraditional":"安平伯","sentenceOrder":211},{"id":"s_work_minh_su_108_212","chapterId":"ch_work_minh_su_108","textTraditional":"魏鵬翼","sentenceOrder":212},{"id":"s_work_minh_su_108_213","chapterId":"ch_work_minh_su_108","textTraditional":"忠賢從孫。天啟七年七月己卯封。八月丙申加少師。莊烈帝即位，伏誅。","sentenceOrder":213},{"id":"s_work_minh_su_108_214","chapterId":"ch_work_minh_su_108","textTraditional":"東安侯","sentenceOrder":214},{"id":"s_work_minh_su_108_215","chapterId":"ch_work_minh_su_108","textTraditional":"魏良棟","sentenceOrder":215},{"id":"s_work_minh_su_108_216","chapterId":"ch_work_minh_su_108","textTraditional":"良卿弟。天啟七年八月乙巳封。莊烈帝即位，伏誅。","sentenceOrder":216},{"id":"s_work_minh_su_108_217","chapterId":"ch_work_minh_su_108","textTraditional":"新樂侯","sentenceOrder":217},{"id":"s_work_minh_su_108_218","chapterId":"ch_work_minh_su_108","textTraditional":"劉效祖","sentenceOrder":218},{"id":"s_work_minh_su_108_219","chapterId":"ch_work_minh_su_108","textTraditional":"莊烈帝母孝純太后弟。莊烈帝即位封。崇禎八年卒。九年，贈侯，予三代誥。十三年九月，父應元追封瀛國公。","sentenceOrder":219},{"id":"s_work_minh_su_108_220","chapterId":"ch_work_minh_su_108","textTraditional":"文炳","sentenceOrder":220},{"id":"s_work_minh_su_108_221","chapterId":"ch_work_minh_su_108","textTraditional":"崇禎九年十二月甲子襲。十三年九月加少傅。十七年三月死難。","sentenceOrder":221},{"id":"s_work_minh_su_108_222","chapterId":"ch_work_minh_su_108","textTraditional":"嘉定伯","sentenceOrder":222},{"id":"s_work_minh_su_108_223","chapterId":"ch_work_minh_su_108","textTraditional":"周奎","sentenceOrder":223},{"id":"s_work_minh_su_108_224","chapterId":"ch_work_minh_su_108","textTraditional":"莊烈后父。崇禎三年封。十七年，京城陷，被執。","sentenceOrder":224}],"overrides":{}}