{"sentences":[{"id":"s_work_clt_181_1","chapterId":"ch_work_clt_181","textTraditional":"一、三十有一年，春，王正月。","sentenceOrder":1},{"id":"s_work_clt_181_2","chapterId":"ch_work_clt_181","textTraditional":"二、夏，六月，辛巳，公薨於楚宮。","sentenceOrder":2},{"id":"s_work_clt_181_3","chapterId":"ch_work_clt_181","textTraditional":"楚宮，非正也。","sentenceOrder":3},{"id":"s_work_clt_181_4","chapterId":"ch_work_clt_181","textTraditional":"三、秋，九月，癸巳，子野卒。","sentenceOrder":4},{"id":"s_work_clt_181_5","chapterId":"ch_work_clt_181","textTraditional":"子卒日，正也。","sentenceOrder":5},{"id":"s_work_clt_181_6","chapterId":"ch_work_clt_181","textTraditional":"四、己亥，仲孫羯卒。","sentenceOrder":6},{"id":"s_work_clt_181_7","chapterId":"ch_work_clt_181","textTraditional":"五、冬，十月，滕子來會葬。","sentenceOrder":7},{"id":"s_work_clt_181_8","chapterId":"ch_work_clt_181","textTraditional":"六、癸酉，葬我君襄公。","sentenceOrder":8},{"id":"s_work_clt_181_9","chapterId":"ch_work_clt_181","textTraditional":"七、十有一月，莒人弒其君密州。","sentenceOrder":9}],"overrides":{}}