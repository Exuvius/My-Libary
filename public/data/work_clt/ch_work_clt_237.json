{"sentences":[{"id":"s_work_clt_237_1","chapterId":"ch_work_clt_237","textTraditional":"一、九年，春，王二月，葬杞僖公。","sentenceOrder":1},{"id":"s_work_clt_237_2","chapterId":"ch_work_clt_237","textTraditional":"二、宋皇瑗帥師取鄭師於雍丘。","sentenceOrder":2},{"id":"s_work_clt_237_3","chapterId":"ch_work_clt_237","textTraditional":"取，易辭也。以師而易取，鄭病矣。","sentenceOrder":3},{"id":"s_work_clt_237_4","chapterId":"ch_work_clt_237","textTraditional":"三、夏，楚人伐陳。","sentenceOrder":4},{"id":"s_work_clt_237_5","chapterId":"ch_work_clt_237","textTraditional":"四、秋，宋公伐鄭。","sentenceOrder":5},{"id":"s_work_clt_237_6","chapterId":"ch_work_clt_237","textTraditional":"五、冬，十月。","sentenceOrder":6}],"overrides":{}}