{"sentences":[{"id":"s_work_clt_233_1","chapterId":"ch_work_clt_233","textTraditional":"一、五年，春，城毗。","sentenceOrder":1},{"id":"s_work_clt_233_2","chapterId":"ch_work_clt_233","textTraditional":"二、夏，齊侯伐宋。","sentenceOrder":2},{"id":"s_work_clt_233_3","chapterId":"ch_work_clt_233","textTraditional":"三、晉趙鞅帥師伐衞。","sentenceOrder":3},{"id":"s_work_clt_233_4","chapterId":"ch_work_clt_233","textTraditional":"四、秋，九月，癸酉，齊侯杵臼卒。","sentenceOrder":4},{"id":"s_work_clt_233_5","chapterId":"ch_work_clt_233","textTraditional":"五、冬，叔遠如齊。","sentenceOrder":5},{"id":"s_work_clt_233_6","chapterId":"ch_work_clt_233","textTraditional":"六、閏月，葬齊景公。","sentenceOrder":6},{"id":"s_work_clt_233_7","chapterId":"ch_work_clt_233","textTraditional":"不正其閏也。","sentenceOrder":7}],"overrides":{}}