{"sentences":[{"id":"s_work_clt_163_1","chapterId":"ch_work_clt_163","textTraditional":"一、十有三年，春，公至自晉。","sentenceOrder":1},{"id":"s_work_clt_163_2","chapterId":"ch_work_clt_163","textTraditional":"二、夏，取邿。","sentenceOrder":2},{"id":"s_work_clt_163_3","chapterId":"ch_work_clt_163","textTraditional":"三、秋，九月，庚辰，楚子審卒。","sentenceOrder":3},{"id":"s_work_clt_163_4","chapterId":"ch_work_clt_163","textTraditional":"四、冬，城防。","sentenceOrder":4}],"overrides":{}}