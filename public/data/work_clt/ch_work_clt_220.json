{"sentences":[{"id":"s_work_clt_220_1","chapterId":"ch_work_clt_220","textTraditional":"一、七年，春，王正月。","sentenceOrder":1},{"id":"s_work_clt_220_2","chapterId":"ch_work_clt_220","textTraditional":"二、夏，四月。","sentenceOrder":2},{"id":"s_work_clt_220_3","chapterId":"ch_work_clt_220","textTraditional":"三、秋，齊侯、鄭伯盟於鹹。","sentenceOrder":3},{"id":"s_work_clt_220_4","chapterId":"ch_work_clt_220","textTraditional":"四、齊人執衞行人北宮結以侵衞。","sentenceOrder":4},{"id":"s_work_clt_220_5","chapterId":"ch_work_clt_220","textTraditional":"以，重辭也，衞人重北宮結。","sentenceOrder":5},{"id":"s_work_clt_220_6","chapterId":"ch_work_clt_220","textTraditional":"五、齊侯、衞侯盟於沙。","sentenceOrder":6},{"id":"s_work_clt_220_7","chapterId":"ch_work_clt_220","textTraditional":"六、大雩。","sentenceOrder":7},{"id":"s_work_clt_220_8","chapterId":"ch_work_clt_220","textTraditional":"七、齊國夏帥師伐我西鄙。","sentenceOrder":8},{"id":"s_work_clt_220_9","chapterId":"ch_work_clt_220","textTraditional":"八、九月，大雩。","sentenceOrder":9},{"id":"s_work_clt_220_10","chapterId":"ch_work_clt_220","textTraditional":"九、冬，十月。","sentenceOrder":10}],"overrides":{}}