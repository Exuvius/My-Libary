id":"s_work_lieu_su_116_188","chapterId":"ch_work_lieu_su_116","textTraditional":"訛莎烈","sentenceOrder":188},{"id":"s_work_lieu_su_116_189","chapterId":"ch_work_lieu_su_116","textTraditional":"地名。","sentenceOrder":189},{"id":"s_work_lieu_su_116_190","chapterId":"ch_work_lieu_su_116","textTraditional":"漚里謹","sentenceOrder":190},{"id":"s_work_lieu_su_116_191","chapterId":"ch_work_lieu_su_116","textTraditional":"地名。","sentenceOrder":191},{"id":"s_work_lieu_su_116_192","chapterId":"ch_work_lieu_su_116","textTraditional":"懽撻新查剌","sentenceOrder":192},{"id":"s_work_lieu_su_116_193","chapterId":"ch_work_lieu_su_116","textTraditional":"地名。","sentenceOrder":193},{"id":"s_work_lieu_su_116_194","chapterId":"ch_work_lieu_su_116","textTraditional":"射糧軍","sentenceOrder":194},{"id":"s_work_lieu_su_116_195","chapterId":"ch_work_lieu_su_116","textTraditional":"射，請也。","sentenceOrder":195},{"id":"s_work_lieu_su_116_196","chapterId":"ch_work_lieu_su_116","textTraditional":"女古底","sentenceOrder":196},{"id":"s_work_lieu_su_116_197","chapterId":"ch_work_lieu_su_116","textTraditional":"地名。","sentenceOrder":197},{"id":"s_work_lieu_su_116_198","chapterId":"ch_work_lieu_su_116","textTraditional":"落昆髓","sentenceOrder":198},{"id":"s_work_lieu_su_116_199","chapterId":"ch_work_lieu_su_116","textTraditional":"地名。","sentenceOrder":199},{"id":"s_work_lieu_su_116_200","chapterId":"ch_work_lieu_su_116","textTraditional":"阿里軫斗","sentenceOrder":200},{"id":"s_work_lieu_su_116_201","chapterId":"ch_work_lieu_su_116","textTraditional":"地名。","sentenceOrder":201},{"id":"s_work_lieu_su_116_202","chapterId":"ch_work_lieu_su_116","textTraditional":"忽兒珊","sentenceOrder":202},{"id":"s_work_lieu_su_116_203","chapterId":"ch_work_lieu_su_116","textTraditional":"西域大軍將名。","sentenceOrder":203},{"id":"s_work_lieu_su_116_204","chapterId":"ch_work_lieu_su_116","textTraditional":"起兒漫","sentenceOrder":204},{"id":"s_work_lieu_su_116_205","chapterId":"ch_work_lieu_su_116","textTraditional":"地名。","sentenceOrder":205},{"id":"s_work_lieu_su_116_206","chapterId":"ch_work_lieu_su_116","textTraditional":"虎思斡魯朵","sentenceOrder":206},{"id":"s_work_lieu_su_116_207","chapterId":"ch_work_lieu_su_116","textTraditional":"思亦作斯，有力稱。斡魯朵，宮帳名。","sentenceOrder":207},{"id":"s_work_lieu_su_116_208","chapterId":"ch_work_lieu_su_116","textTraditional":"葛兒罕","sentenceOrder":208},{"id":"s_work_lieu_su_116_209","chapterId":"ch_work_lieu_su_116","textTraditional":"漠北君王稱。","sentenceOrder":209},{"id":"s_work_lieu_su_116_210","chapterId":"ch_work_lieu_su_116","textTraditional":"禮志：","sentenceOrder":210},{"id":"s_work_lieu_su_116_211","chapterId":"ch_work_lieu_su_116","textTraditional":"祭東","sentenceOrder":211},{"id":"s_work_lieu_su_116_212","chapterId":"ch_work_lieu_su_116","textTraditional":"國俗，凡祭皆東向，故曰祭東。","sentenceOrder":212},{"id":"s_work_lieu_su_116_213","chapterId":"ch_work_lieu_su_116","textTraditional":"敵烈麻都","sentenceOrder":213},{"id":"s_work_lieu_su_116_214","chapterId":"ch_work_lieu_su_116","textTraditional":"掌禮官。","sentenceOrder":214},{"id":"s_work_lieu_su_116_215","chapterId":"ch_work_lieu_su_116","textTraditional":"旗鼓拽剌","sentenceOrder":215},{"id":"s_work_lieu_su_116_216","chapterId":"ch_work_lieu_su_116","textTraditional":"拽剌，官名。軍制有拽剌司；此則掌旗鼓者也。","sentenceOrder":216},{"id":"s_work_lieu_su_116_217","chapterId":"ch_work_lieu_su_116","textTraditional":"爇節","sentenceOrder":217},{"id":"s_work_lieu_su_116_218","chapterId":"ch_work_lieu_su_116","textTraditional":"歲時雜禮名。","sentenceOrder":218},{"id":"s_work_lieu_su_116_219","chapterId":"ch_work_lieu_su_116","textTraditional":"九奚首","sentenceOrder":219},{"id":"s_work_lieu_su_116_220","chapterId":"ch_work_lieu_su_116","textTraditional":"奚首，營帳名。","sentenceOrder":220},{"id":"s_work_lieu_su_116_221","chapterId":"ch_work_lieu_su_116","textTraditional":"食羖之次","sentenceOrder":221},{"id":"s_work_lieu_su_116_222","chapterId":"ch_work_lieu_su_116","textTraditional":"大行殯出，群臣以羖羊祭于路，名曰食羖之次。","sentenceOrder":222},{"id":"s_work_lieu_su_116_223","chapterId":"ch_work_lieu_su_116","textTraditional":"〈礻厭〉祭上於琰切。","sentenceOrder":223},{"id":"s_work_lieu_su_116_224","chapterId":"ch_work_lieu_su_116","textTraditional":"凡出征，以牝牡麃各一祭之曰〈礻厭〉，詛敵也。","sentenceOrder":224},{"id":"s_work_lieu_su_116_225","chapterId":"ch_work_lieu_su_116","textTraditional":"勘箭","sentenceOrder":225},{"id":"s_work_lieu_su_116_226","chapterId":"ch_work_lieu_su_116","textTraditional":"車駕遠歸，閤門使持雄箭，勘箭官持雌箭，比較相合，而後入宮。","sentenceOrder":226},{"id":"s_work_lieu_su_116_227","chapterId":"ch_work_lieu_su_116","textTraditional":"檐床","sentenceOrder":227},{"id":"s_work_lieu_su_116_228","chapterId":"ch_work_lieu_su_116","textTraditional":"一人肩任曰檐，兩人以手共舁曰床。","sentenceOrder":228},{"id":"s_work_lieu_su_116_229","chapterId":"ch_work_lieu_su_116","textTraditional":"攢隊","sentenceOrder":229},{"id":"s_work_lieu_su_116_230","chapterId":"ch_work_lieu_su_116","textTraditional":"士卒攢簇，各為隊伍。","sentenceOrder":230},{"id":"s_work_lieu_su_116_231","chapterId":"ch_work_lieu_su_116","textTraditional":"方裀、朵殿","sentenceOrder":231},{"id":"s_work_lieu_su_116_232","chapterId":"ch_work_lieu_su_116","textTraditional":"凡御宴，官卑，地坐殿中方墩之上；其不應升殿，則賜坐左右朵殿。","sentenceOrder":232},{"id":"s_work_lieu_su_116_233","chapterId":"ch_work_lieu_su_116","textTraditional":"地拍","sentenceOrder":233},{"id":"s_work_lieu_su_116_234","chapterId":"ch_work_lieu_su_116","textTraditional":"田鼠名。正旦日，上於牕間擲米團，得隻數為不利，則燒地拍鼠以禳之。","sentenceOrder":234},{"id":"s_work_lieu_su_116_235","chapterId":"ch_work_lieu_su_116","textTraditional":"迺捏咿唲","sentenceOrder":235},{"id":"s_work_lieu_su_116_236","chapterId":"ch_work_lieu_su_116","textTraditional":"正月朔旦也。","sentenceOrder":236},{"id":"s_work_lieu_su_116_237","chapterId":"ch_work_lieu_su_116","textTraditional":"〈忄甲〉里尀","sentenceOrder":237},{"id":"s_work_lieu_su_116_238","chapterId":"ch_work_lieu_su_116","textTraditional":"〈忄甲〉讀作狎，尀讀作頗。二月一日也。六月十八日宴國舅族，亦曰〈忄甲〉里尀。","sentenceOrder":238},{"id":"s_work_lieu_su_116_239","chapterId":"ch_work_lieu_su_116","textTraditional":"陶里樺","sentenceOrder":239},{"id":"s_work_lieu_su_116_240","chapterId":"ch_work_lieu_su_116","textTraditional":"上巳日，射兔之節名。","sentenceOrder":240},{"id":"s_work_lieu_su_116_241","chapterId":"ch_work_lieu_su_116","textTraditional":"討賽咿唲","sentenceOrder":241},{"id":"s_work_lieu_su_116_242","chapterId":"ch_work_lieu_su_116","textTraditional":"重午日也。","sentenceOrder":242},{"id":"s_work_lieu_su_116_243","chapterId":"ch_work_lieu_su_116","textTraditional":"賽伊唲奢","sentenceOrder":243},{"id":"s_work_lieu_su_116_244","chapterId":"ch_work_lieu_su_116","textTraditional":"日辰之好也。","sentenceOrder":244},{"id":"s_work_lieu_su_116_245","chapterId":"ch_work_lieu_su_116","textTraditional":"捏褐耐","sentenceOrder":245},{"id":"s_work_lieu_su_116_246","chapterId":"ch_work_lieu_su_116","textTraditional":"犬首也。","sentenceOrder":246},{"id":"s_work_lieu_su_116_247","chapterId":"ch_work_lieu_su_116","textTraditional":"必里遲離","sentenceOrder":247},{"id":"s_work_lieu_su_116_248","chapterId":"ch_work_lieu_su_116","textTraditional":"重九日也。","sentenceOrder":248},{"id":"s_work_lieu_su_116_249","chapterId":"ch_work_lieu_su_116","textTraditional":"戴辣","sentenceOrder":249},{"id":"s_work_lieu_su_116_250","chapterId":"ch_work_lieu_su_116","textTraditional":"燒甲也。","sentenceOrder":250},{"id":"s_work_lieu_su_116_251","chapterId":"ch_work_lieu_su_116","textTraditional":"炒伍侕尀","sentenceOrder":251},{"id":"s_work_lieu_su_116_252","chapterId":"ch_work_lieu_su_116","textTraditional":"尀戰名也。","sentenceOrder":252},{"id":"s_work_lieu_su_116_253","chapterId":"ch_work_lieu_su_116","textTraditional":"卓帳","sentenceOrder":253},{"id":"s_work_lieu_su_116_254","chapterId":"ch_work_lieu_su_116","textTraditional":"卓，立也。帳，氈廬也。","sentenceOrder":254},{"id":"s_work_lieu_su_116_255","chapterId":"ch_work_lieu_su_116","textTraditional":"百官志：","sentenceOrder":255},{"id":"s_work_lieu_su_116_256","chapterId":"ch_work_lieu_su_116","textTraditional":"石烈辛袞","sentenceOrder":256},{"id":"s_work_lieu_su_116_257","chapterId":"ch_work_lieu_su_116","textTraditional":"石烈官之長。","sentenceOrder":257},{"id":"s_work_lieu_su_116_258","chapterId":"ch_work_lieu_su_116","textTraditional":"令穩","sentenceOrder":258},{"id":"s_work_lieu_su_116_259","chapterId":"ch_work_lieu_su_116","textTraditional":"官名。","sentenceOrder":259},{"id":"s_work_lieu_su_116_260","chapterId":"ch_work_lieu_su_116","textTraditional":"彌里馬特本","sentenceOrder":260},{"id":"s_work_lieu_su_116_261","chapterId":"ch_work_lieu_su_116","textTraditional":"官名，後陞辛袞。","sentenceOrder":261},{"id":"s_work_lieu_su_116_262","chapterId":"ch_work_lieu_su_116","textTraditional":"麻普","sentenceOrder":262},{"id":"s_work_lieu_su_116_263","chapterId":"ch_work_lieu_su_116","textTraditional":"即麻都不，縣官之副也，初名達剌干。","sentenceOrder":263},{"id":"s_work_lieu_su_116_264","chapterId":"ch_work_lieu_su_116","textTraditional":"知聖旨頭子事","sentenceOrder":264},{"id":"s_work_lieu_su_116_265","chapterId":"ch_work_lieu_su_116","textTraditional":"掌誥命奏事官。","sentenceOrder":265},{"id":"s_work_lieu_su_116_266","chapterId":"ch_work_lieu_su_116","textTraditional":"提轄司","sentenceOrder":266},{"id":"s_work_lieu_su_116_267","chapterId":"ch_work_lieu_su_116","textTraditional":"諸宮典兵官。","sentenceOrder":267},{"id":"s_work_lieu_su_116_268","chapterId":"ch_work_lieu_su_116","textTraditional":"皮室","sentenceOrder":268},{"id":"s_work_lieu_su_116_269","chapterId":"ch_work_lieu_su_116","textTraditional":"軍制，有南、北、左、右皮室及黃皮室，皆掌精兵。","sentenceOrder":269},{"id":"s_work_lieu_su_116_270","chapterId":"ch_work_lieu_su_116","textTraditional":"廳房","sentenceOrder":270},{"id":"s_work_lieu_su_116_271","chapterId":"ch_work_lieu_su_116","textTraditional":"即工部。","sentenceOrder":271},{"id":"s_work_lieu_su_116_272","chapterId":"ch_work_lieu_su_116","textTraditional":"梅里","sentenceOrder":272},{"id":"s_work_lieu_su_116_273","chapterId":"ch_work_lieu_su_116","textTraditional":"貴戚官名。述律皇后族有慎思梅里、婆姑梅里，未詳何職。","sentenceOrder":273},{"id":"s_work_lieu_su_116_274","chapterId":"ch_work_lieu_su_116","textTraditional":"抹鶻","sentenceOrder":274},{"id":"s_work_lieu_su_116_275","chapterId":"ch_work_lieu_su_116","textTraditional":"瓦里司之官。","sentenceOrder":275},{"id":"s_work_lieu_su_116_276","chapterId":"ch_work_lieu_su_116","textTraditional":"先離撻覽","sentenceOrder":276},{"id":"s_work_lieu_su_116_277","chapterId":"ch_work_lieu_su_116","textTraditional":"奚、渤海等國官名，疑即撻林字訛。","sentenceOrder":277},{"id":"s_work_lieu_su_116_278","chapterId":"ch_work_lieu_su_116","textTraditional":"營衛志：","sentenceOrder":278},{"id":"s_work_lieu_su_116_279","chapterId":"ch_work_lieu_su_116","textTraditional":"象吻","sentenceOrder":279},{"id":"s_work_lieu_su_116_280","chapterId":"ch_work_lieu_su_116","textTraditional":"黃帝治宮室，陶蚩尤象置棟上，名曰蚩吻。","sentenceOrder":280},{"id":"s_work_lieu_su_116_281","chapterId":"ch_work_lieu_su_116","textTraditional":"瓦里","sentenceOrder":281},{"id":"s_work_lieu_su_116_282","chapterId":"ch_work_lieu_su_116","textTraditional":"官府名，宮帳、部族皆設之。凡宗室、外戚、大臣犯罪者，家屬沒入於此。","sentenceOrder":282},{"id":"s_work_lieu_su_116_283","chapterId":"ch_work_lieu_su_116","textTraditional":"抹里","sentenceOrder":283},{"id":"s_work_lieu_su_116_284","chapterId":"ch_work_lieu_su_116","textTraditional":"官府名。閘撒狘亦抹里官之一。","sentenceOrder":284},{"id":"s_work_lieu_su_116_285","chapterId":"ch_work_lieu_su_116","textTraditional":"算斡魯朵","sentenceOrder":285},{"id":"s_work_lieu_su_116_286","chapterId":"ch_work_lieu_su_116","textTraditional":"算，腹心拽剌也。斡魯朵，宮也。已下國阿輦至監母，皆斡魯朵名；其注語，則始置之義也。","sentenceOrder":286},{"id":"s_work_lieu_su_116_287","chapterId":"ch_work_lieu_su_116","textTraditional":"國阿輦","sentenceOrder":287},{"id":"s_work_lieu_su_116_288","chapterId":"ch_work_lieu_su_116","textTraditional":"收國也。","sentenceOrder":288},{"id":"s_work_lieu_su_116_289","chapterId":"ch_work_lieu_su_116","textTraditional":"奪里本","sentenceOrder":289},{"id":"s_work_lieu_su_116_290","chapterId":"ch_work_lieu_su_116","textTraditional":"討平也。","sentenceOrder":290},{"id":"s_work_lieu_su_116_291","chapterId":"ch_work_lieu_su_116","textTraditional":"耶魯碗","sentenceOrder":291},{"id":"s_work_lieu_su_116_292","chapterId":"ch_work_lieu_su_116","textTraditional":"興旺也。","sentenceOrder":292},{"id":"s_work_lieu_su_116_293","chapterId":"ch_work_lieu_su_116","textTraditional":"蒲速碗","sentenceOrder":293},{"id":"s_work_lieu_su_116_294","chapterId":"ch_work_lieu_su_116","textTraditional":"義與耶魯碗同。","sentenceOrder":294},{"id":"s_work_lieu_su_116_295","chapterId":"ch_work_lieu_su_116","textTraditional":"女古","sentenceOrder":295},{"id":"s_work_lieu_su_116_296","chapterId":"ch_work_lieu_su_116","textTraditional":"金也。","sentenceOrder":296},{"id":"s_work_lieu_su_116_297","chapterId":"ch_work_lieu_su_116","textTraditional":"孤穩","sentenceOrder":297},{"id":"s_work_lieu_su_116_298","chapterId":"ch_work_lieu_su_116","textTraditional":"玉也。","sentenceOrder":298},{"id":"s_work_lieu_su_116_299","chapterId":"ch_work_lieu_su_116","textTraditional":"窩篤碗","sentenceOrder":299},{"id":"s_work_lieu_su_116_300","chapterId":"ch_work_lieu_su_116","textTraditional":"孳息也。","sentenceOrder":300},{"id":"s_work_lieu_su_116_301","chapterId":"ch_work_lieu_su_116","textTraditional":"阿斯","sentenceOrder":301},{"id":"s_work_lieu_su_116_302","chapterId":"ch_work_lieu_su_116","textTraditional":"寬大也。","sentenceOrder":302},{"id":"s_work_lieu_su_116_303","chapterId":"ch_work_lieu_su_116","textTraditional":"阿魯碗","sentenceOrder":303},{"id":"s_work_lieu_su_116_304","chapterId":"ch_work_lieu_su_116","textTraditional":"輔佑也。","sentenceOrder":304},{"id":"s_work_lieu_su_116_305","chapterId":"ch_work_lieu_su_116","textTraditional":"得失得本","sentenceOrder":305},{"id":"s_work_lieu_su_116_306","chapterId":"ch_work_lieu_su_116","textTraditional":"孝也。","sentenceOrder":306},{"id":"s_work_lieu_su_116_307","chapterId":"ch_work_lieu_su_116","textTraditional":"監母","sentenceOrder":307},{"id":"s_work_lieu_su_116_308","chapterId":"ch_work_lieu_su_116","textTraditional":"遺留也。","sentenceOrder":308},{"id":"s_work_lieu_su_116_309","chapterId":"ch_work_lieu_su_116","textTraditional":"地理志：","sentenceOrder":309},{"id":"s_work_lieu_su_116_310","chapterId":"ch_work_lieu_su_116","textTraditional":"屬珊","sentenceOrder":310},{"id":"s_work_lieu_su_116_311","chapterId":"ch_work_lieu_su_116","textTraditional":"應天皇后從太祖征討，所俘人戶有技藝者置之帳下，名屬珊，蓋比珊瑚之寶。","sentenceOrder":311},{"id":"s_work_lieu_su_116_312","chapterId":"ch_work_lieu_su_116","textTraditional":"永州","sentenceOrder":312},{"id":"s_work_lieu_su_116_313","chapterId":"ch_work_lieu_su_116","textTraditional":"其地居潢河、土河二水之間，故名永州，蓋以字從二、從水也。","sentenceOrder":313},{"id":"s_work_lieu_su_116_314","chapterId":"ch_work_lieu_su_116","textTraditional":"鄚頡上慕各切，下胡結切。","sentenceOrder":314},{"id":"s_work_lieu_su_116_315","chapterId":"ch_work_lieu_su_116","textTraditional":"渤海郡府名。","sentenceOrder":315},{"id":"s_work_lieu_su_116_316","chapterId":"ch_work_lieu_su_116","textTraditional":"且慮皆平聲。","sentenceOrder":316},{"id":"s_work_lieu_su_116_317","chapterId":"ch_work_lieu_su_116","textTraditional":"興中府縣名。","sentenceOrder":317},{"id":"s_work_lieu_su_116_318","chapterId":"ch_work_lieu_su_116","textTraditional":"貕養上音奚。","sentenceOrder":318},{"id":"s_work_lieu_su_116_319","chapterId":"ch_work_lieu_su_116","textTraditional":"幽州澤藪名，見周職方。","sentenceOrder":319},{"id":"s_work_lieu_su_116_320","chapterId":"ch_work_lieu_su_116","textTraditional":"菑、時","sentenceOrder":320},{"id":"s_work_lieu_su_116_321","chapterId":"ch_work_lieu_su_116","textTraditional":"幽州浸名，出同上。","sentenceOrder":321},{"id":"s_work_lieu_su_116_322","chapterId":"ch_work_lieu_su_116","textTraditional":"墮瑰","sentenceOrder":322},{"id":"s_work_lieu_su_116_323","chapterId":"ch_work_lieu_su_116","textTraditional":"門名，遼有墮瑰部。","sentenceOrder":323},{"id":"s_work_lieu_su_116_324","chapterId":"ch_work_lieu_su_116","textTraditional":"野旅寅","sentenceOrder":324},{"id":"s_work_lieu_su_116_325","chapterId":"ch_work_lieu_su_116","textTraditional":"野謂星野，旅謂躔次；寅者，辰舍。東北之位，燕分析津之所也。","sentenceOrder":325},{"id":"s_work_lieu_su_116_326","chapterId":"ch_work_lieu_su_116","textTraditional":"儀衛志：","sentenceOrder":326},{"id":"s_work_lieu_su_116_327","chapterId":"ch_work_lieu_su_116","textTraditional":"金〈夌，土改凶〉下祖叢切。","sentenceOrder":327},{"id":"s_work_lieu_su_116_328","chapterId":"ch_work_lieu_su_116","textTraditional":"馬首飾也。","sentenceOrder":328},{"id":"s_work_lieu_su_116_329","chapterId":"ch_work_lieu_su_116","textTraditional":"果下馬","sentenceOrder":329},{"id":"s_work_lieu_su_116_330","chapterId":"ch_work_lieu_su_116","textTraditional":"馬名。謂果樹下可乘行者，言其小也。","sentenceOrder":330},{"id":"s_work_lieu_su_116_331","chapterId":"ch_work_lieu_su_116","textTraditional":"實里薛袞","sentenceOrder":331},{"id":"s_work_lieu_su_116_332","chapterId":"ch_work_lieu_su_116","textTraditional":"祭服之冠，行拜山禮則服之。","sentenceOrder":332},{"id":"s_work_lieu_su_116_333","chapterId":"ch_work_lieu_su_116","textTraditional":"〈革占〉鞢帶上他協切，下徒協切。","sentenceOrder":333},{"id":"s_work_lieu_su_116_334","chapterId":"ch_work_lieu_su_116","textTraditional":"武官束帶也。","sentenceOrder":334},{"id":"s_work_lieu_su_116_335","chapterId":"ch_work_lieu_su_116","textTraditional":"扞腰","sentenceOrder":335},{"id":"s_work_lieu_su_116_336","chapterId":"ch_work_lieu_su_116","textTraditional":"即拄腰，以鵝項、鴨頭為之。","sentenceOrder":336},{"id":"s_work_lieu_su_116_337","chapterId":"ch_work_lieu_su_116","textTraditional":"胡木鍪","sentenceOrder":337},{"id":"s_work_lieu_su_116_338","chapterId":"ch_work_lieu_su_116","textTraditional":"冑名。","sentenceOrder":338},{"id":"s_work_lieu_su_116_339","chapterId":"ch_work_lieu_su_116","textTraditional":"〈革延〉馬上音誕。","sentenceOrder":339},{"id":"s_work_lieu_su_116_340","chapterId":"ch_work_lieu_su_116","textTraditional":"馬不施鞍轡曰〈革延〉。","sentenceOrder":340},{"id":"s_work_lieu_su_116_341","chapterId":"ch_work_lieu_su_116","textTraditional":"白毦音餌。","sentenceOrder":341},{"id":"s_work_lieu_su_116_342","chapterId":"ch_work_lieu_su_116","textTraditional":"以白鷺羽為網，又罽也。","sentenceOrder":342},{"id":"s_work_lieu_su_116_343","chapterId":"ch_work_lieu_su_116","textTraditional":"兵衛志：","sentenceOrder":343},{"id":"s_work_lieu_su_116_344","chapterId":"ch_work_lieu_su_116","textTraditional":"捉馬","sentenceOrder":344},{"id":"s_work_lieu_su_116_345","chapterId":"ch_work_lieu_su_116","textTraditional":"拘刷馬也。","sentenceOrder":345},{"id":"s_work_lieu_su_116_346","chapterId":"ch_work_lieu_su_116","textTraditional":"欄子軍","sentenceOrder":346},{"id":"s_work_lieu_su_116_347","chapterId":"ch_work_lieu_su_116","textTraditional":"居先鋒前二十餘里，偵候敵人動靜。","sentenceOrder":347},{"id":"s_work_lieu_su_116_348","chapterId":"ch_work_lieu_su_116","textTraditional":"弓子鋪","sentenceOrder":348},{"id":"s_work_lieu_su_116_349","chapterId":"ch_work_lieu_su_116","textTraditional":"遼軍馬頓舍，不設營塹，折木稍為弓，以為團集之所。又諸國使來，道旁簽置木稍弓，以充欄楯。","sentenceOrder":349},{"id":"s_work_lieu_su_116_350","chapterId":"ch_work_lieu_su_116","textTraditional":"食貨志：","sentenceOrder":350},{"id":"s_work_lieu_su_116_351","chapterId":"ch_work_lieu_su_116","textTraditional":"云為所","sentenceOrder":351},{"id":"s_work_lieu_su_116_352","chapterId":"ch_work_lieu_su_116","textTraditional":"義即營運，字之訛。","sentenceOrder":352},{"id":"s_work_lieu_su_116_353","chapterId":"ch_work_lieu_su_116","textTraditional":"刑法志：","sentenceOrder":353},{"id":"s_work_lieu_su_116_354","chapterId":"ch_work_lieu_su_116","textTraditional":"鐘院","sentenceOrder":354},{"id":"s_work_lieu_su_116_355","chapterId":"ch_work_lieu_su_116","textTraditional":"有冤者擊鐘，以達于上，猶怨鼓云。","sentenceOrder":355},{"id":"s_work_lieu_su_116_356","chapterId":"ch_work_lieu_su_116","textTraditional":"楚古","sentenceOrder":356},{"id":"s_work_lieu_su_116_357","chapterId":"ch_work_lieu_su_116","textTraditional":"官名。掌北面訊囚者。","sentenceOrder":357},{"id":"s_work_lieu_su_116_358","chapterId":"ch_work_lieu_su_116","textTraditional":"皇子表：","sentenceOrder":358},{"id":"s_work_lieu_su_116_359","chapterId":"ch_work_lieu_su_116","textTraditional":"五石烈","sentenceOrder":359},{"id":"s_work_lieu_su_116_360","chapterId":"ch_work_lieu_su_116","textTraditional":"即五院。非是分院為五，以五石烈為一院也。","sentenceOrder":360},{"id":"s_work_lieu_su_116_361","chapterId":"ch_work_lieu_su_116","textTraditional":"六爪","sentenceOrder":361},{"id":"s_work_lieu_su_116_362","chapterId":"ch_work_lieu_su_116","textTraditional":"爪，百數也。遼有六百家奚，後為六院，義與五院同。二院，即迭剌部析之為二者是也。","sentenceOrder":362},{"id":"s_work_lieu_su_116_363","chapterId":"ch_work_lieu_su_116","textTraditional":"裂{鹿加}皮","sentenceOrder":363},{"id":"s_work_lieu_su_116_364","chapterId":"ch_work_lieu_su_116","textTraditional":"{鹿加}{鹿加}，牡鹿。力能分牡鹿皮。","sentenceOrder":364},{"id":"s_work_lieu_su_116_365","chapterId":"ch_work_lieu_su_116","textTraditional":"世表：","sentenceOrder":365},{"id":"s_work_lieu_su_116_366","chapterId":"ch_work_lieu_su_116","textTraditional":"莫弗紇","sentenceOrder":366},{"id":"s_work_lieu_su_116_367","chapterId":"ch_work_lieu_su_116","textTraditional":"諸部酋長稱，又云莫弗賀。","sentenceOrder":367},{"id":"s_work_lieu_su_116_368","chapterId":"ch_work_lieu_su_116","textTraditional":"蠕蠕而宣切。","sentenceOrder":368},{"id":"s_work_lieu_su_116_369","chapterId":"ch_work_lieu_su_116","textTraditional":"國名。","sentenceOrder":369},{"id":"s_work_lieu_su_116_370","chapterId":"ch_work_lieu_su_116","textTraditional":"俟斤","sentenceOrder":370},{"id":"s_work_lieu_su_116_371","chapterId":"ch_work_lieu_su_116","textTraditional":"突厥官名。","sentenceOrder":371},{"id":"s_work_lieu_su_116_372","chapterId":"ch_work_lieu_su_116","textTraditional":"遊幸表：","sentenceOrder":372},{"id":"s_work_lieu_su_116_373","chapterId":"ch_work_lieu_su_116","textTraditional":"舔鹹鹿","sentenceOrder":373},{"id":"s_work_lieu_su_116_374","chapterId":"ch_work_lieu_su_116","textTraditional":"鹿性嗜鹹，灑鹼於地以誘鹿，射之。","sentenceOrder":374},{"id":"s_work_lieu_su_116_375","chapterId":"ch_work_lieu_su_116","textTraditional":"女瓌","sentenceOrder":375},{"id":"s_work_lieu_su_116_376","chapterId":"ch_work_lieu_su_116","textTraditional":"虞人名。","sentenceOrder":376},{"id":"s_work_lieu_su_116_377","chapterId":"ch_work_lieu_su_116","textTraditional":"列傳","sentenceOrder":377},{"id":"s_work_lieu_su_116_378","chapterId":"ch_work_lieu_su_116","textTraditional":"可敦","sentenceOrder":378},{"id":"s_work_lieu_su_116_379","chapterId":"ch_work_lieu_su_116","textTraditional":"突厥皇后之稱。","sentenceOrder":379},{"id":"s_work_lieu_su_116_380","chapterId":"ch_work_lieu_su_116","textTraditional":"忒里蹇","sentenceOrder":380},{"id":"s_work_lieu_su_116_381","chapterId":"ch_work_lieu_su_116","textTraditional":"遼皇后之稱。","sentenceOrder":381},{"id":"s_work_lieu_su_116_382","chapterId":"ch_work_lieu_su_116","textTraditional":"耨斡麼","sentenceOrder":382},{"id":"s_work_lieu_su_116_383","chapterId":"ch_work_lieu_su_116","textTraditional":"麼，亦作改。耨斡，后土稱。麼，母稱。","sentenceOrder":383},{"id":"s_work_lieu_su_116_384","chapterId":"ch_work_lieu_su_116","textTraditional":"乙室、拔里","sentenceOrder":384},{"id":"s_work_lieu_su_116_385","chapterId":"ch_work_lieu_su_116","textTraditional":"國舅帳二族名。","sentenceOrder":385},{"id":"s_work_lieu_su_116_386","chapterId":"ch_work_lieu_su_116","textTraditional":"諸功臣傳：","sentenceOrder":386},{"id":"s_work_lieu_su_116_387","chapterId":"ch_work_lieu_su_116","textTraditional":"龍錫金佩","sentenceOrder":387},{"id":"s_work_lieu_su_116_388","chapterId":"ch_work_lieu_su_116","textTraditional":"太祖從兄鐸骨札以本帳下蛇鳴，命知蛇語者神速姑解之，知蛇謂穴傍樹中有金，往取之，果得金，以為帶，名「龍錫金」。","sentenceOrder":388},{"id":"s_work_lieu_su_116_389","chapterId":"ch_work_lieu_su_116","textTraditional":"撒剌","sentenceOrder":389},{"id":"s_work_lieu_su_116_390","chapterId":"ch_work_lieu_su_116","textTraditional":"酒樽名。","sentenceOrder":390},{"id":"s_work_lieu_su_116_391","chapterId":"ch_work_lieu_su_116","textTraditional":"遙輦糾","sentenceOrder":391},{"id":"s_work_lieu_su_116_392","chapterId":"ch_work_lieu_su_116","textTraditional":"遙輦帳下軍也。其書永興宮分糾、十二行糾、黃皮室糾者，倣此。","sentenceOrder":392},{"id":"s_work_lieu_su_116_393","chapterId":"ch_work_lieu_su_116","textTraditional":"吐里","sentenceOrder":393},{"id":"s_work_lieu_su_116_394","chapterId":"ch_work_lieu_su_116","textTraditional":"官名。與奚六部禿里同。吐、禿字訛。","sentenceOrder":394},{"id":"s_work_lieu_su_116_395","chapterId":"ch_work_lieu_su_116","textTraditional":"寢殿小底","sentenceOrder":395},{"id":"s_work_lieu_su_116_396","chapterId":"ch_work_lieu_su_116","textTraditional":"官名。遼制多小底官，餘不注。","sentenceOrder":396},{"id":"s_work_lieu_s