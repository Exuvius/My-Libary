_109","chapterId":"ch_work_lieu_su_69","textTraditional":"五年","sentenceOrder":109},{"id":"s_work_lieu_su_69_110","chapterId":"ch_work_lieu_su_69","textTraditional":"鼻骨德來貢。","sentenceOrder":110},{"id":"s_work_lieu_su_69_111","chapterId":"ch_work_lieu_su_69","textTraditional":"六年","sentenceOrder":111},{"id":"s_work_lieu_su_69_112","chapterId":"ch_work_lieu_su_69","textTraditional":"鼻骨德來貢。","sentenceOrder":112},{"id":"s_work_lieu_su_69_113","chapterId":"ch_work_lieu_su_69","textTraditional":"七年","sentenceOrder":113},{"id":"s_work_lieu_su_69_114","chapterId":"ch_work_lieu_su_69","textTraditional":"鼻骨德來貢。","sentenceOrder":114},{"id":"s_work_lieu_su_69_115","chapterId":"ch_work_lieu_su_69","textTraditional":"十四年","sentenceOrder":115},{"id":"s_work_lieu_su_69_116","chapterId":"ch_work_lieu_su_69","textTraditional":"黃室韋叛。","sentenceOrder":116},{"id":"s_work_lieu_su_69_117","chapterId":"ch_work_lieu_su_69","textTraditional":"庫古只奏黃室韋掠馬牛，叛去。庫古只與黃室韋戰，敗之，降其眾。賜詔撫諭。","sentenceOrder":117},{"id":"s_work_lieu_su_69_118","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古叛，掠居民財蓄。","sentenceOrder":118},{"id":"s_work_lieu_su_69_119","chapterId":"ch_work_lieu_su_69","textTraditional":"十五年","sentenceOrder":119},{"id":"s_work_lieu_su_69_120","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古殺其酋長窣離底，降而復叛。","sentenceOrder":120},{"id":"s_work_lieu_su_69_121","chapterId":"ch_work_lieu_su_69","textTraditional":"大黃室韋酋長寅底吉叛。五坊人四十戶叛入烏古。","sentenceOrder":121},{"id":"s_work_lieu_su_69_122","chapterId":"ch_work_lieu_su_69","textTraditional":"小黃室韋叛去，雅里斯、楚思等擊之，為室韋所敗。遣使讓之。","sentenceOrder":122},{"id":"s_work_lieu_su_69_123","chapterId":"ch_work_lieu_su_69","textTraditional":"庫古只奏室韋酋長寅底吉亡入敵烈。","sentenceOrder":123},{"id":"s_work_lieu_su_69_124","chapterId":"ch_work_lieu_su_69","textTraditional":"敵烈來降。","sentenceOrder":124},{"id":"s_work_lieu_su_69_125","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古至河德濼，遣夷離菫畫里、夷離畢常恩以擊之。丁丑，烏古掠上京北榆林峪居民，遣林牙蕭幹討之。","sentenceOrder":125},{"id":"s_work_lieu_su_69_126","chapterId":"ch_work_lieu_su_69","textTraditional":"常恩與烏古戰，大敗之。","sentenceOrder":126},{"id":"s_work_lieu_su_69_127","chapterId":"ch_work_lieu_su_69","textTraditional":"十七年","sentenceOrder":127},{"id":"s_work_lieu_su_69_128","chapterId":"ch_work_lieu_su_69","textTraditional":"夷離畢骨欲獻烏古之俘。","sentenceOrder":128},{"id":"s_work_lieu_su_69_129","chapterId":"ch_work_lieu_su_69","textTraditional":"景宗","sentenceOrder":129},{"id":"s_work_lieu_su_69_130","chapterId":"ch_work_lieu_su_69","textTraditional":"保寧三年","sentenceOrder":130},{"id":"s_work_lieu_su_69_131","chapterId":"ch_work_lieu_su_69","textTraditional":"鼻骨德來貢。","sentenceOrder":131},{"id":"s_work_lieu_su_69_132","chapterId":"ch_work_lieu_su_69","textTraditional":"四年","sentenceOrder":132},{"id":"s_work_lieu_su_69_133","chapterId":"ch_work_lieu_su_69","textTraditional":"鼻骨德來貢。","sentenceOrder":133},{"id":"s_work_lieu_su_69_134","chapterId":"ch_work_lieu_su_69","textTraditional":"五年","sentenceOrder":134},{"id":"s_work_lieu_su_69_135","chapterId":"ch_work_lieu_su_69","textTraditional":"鼻骨德部長曷魯撻覽來朝。","sentenceOrder":135},{"id":"s_work_lieu_su_69_136","chapterId":"ch_work_lieu_su_69","textTraditional":"八年","sentenceOrder":136},{"id":"s_work_lieu_su_69_137","chapterId":"ch_work_lieu_su_69","textTraditional":"鼻骨德來貢。","sentenceOrder":137},{"id":"s_work_lieu_su_69_138","chapterId":"ch_work_lieu_su_69","textTraditional":"乾亨元年","sentenceOrder":138},{"id":"s_work_lieu_su_69_139","chapterId":"ch_work_lieu_su_69","textTraditional":"敵烈來貢。","sentenceOrder":139},{"id":"s_work_lieu_su_69_140","chapterId":"ch_work_lieu_su_69","textTraditional":"聖宗統和元年","sentenceOrder":140},{"id":"s_work_lieu_su_69_141","chapterId":"ch_work_lieu_su_69","textTraditional":"速撒奏降敵烈部。速撒奏叛蕃來降。","sentenceOrder":141},{"id":"s_work_lieu_su_69_142","chapterId":"ch_work_lieu_su_69","textTraditional":"二年","sentenceOrder":142},{"id":"s_work_lieu_su_69_143","chapterId":"ch_work_lieu_su_69","textTraditional":"五國、隈烏古部節度使耶律隈窪以所轄諸部難制，請賜詔、給，仍便宜從事。從之。","sentenceOrder":143},{"id":"s_work_lieu_su_69_144","chapterId":"ch_work_lieu_su_69","textTraditional":"劃離部人請今後詳穩只於當部選授，上以諸部官長惟在得人，詔不允。","sentenceOrder":144},{"id":"s_work_lieu_su_69_145","chapterId":"ch_work_lieu_su_69","textTraditional":"耶律蒲寧、都監蕭勤德東征女直回，獻捷。","sentenceOrder":145},{"id":"s_work_lieu_su_69_146","chapterId":"ch_work_lieu_su_69","textTraditional":"三年","sentenceOrder":146},{"id":"s_work_lieu_su_69_147","chapterId":"ch_work_lieu_su_69","textTraditional":"上閱諸部籍，以涅剌、烏隈二部額少役重，故量免之。","sentenceOrder":147},{"id":"s_work_lieu_su_69_148","chapterId":"ch_work_lieu_su_69","textTraditional":"乙室奧隗部黍過熟未穫，遣人以助收刈。","sentenceOrder":148},{"id":"s_work_lieu_su_69_149","chapterId":"ch_work_lieu_su_69","textTraditional":"乙室姥隈部族副使進物。朮不姑諸部來至近地。","sentenceOrder":149},{"id":"s_work_lieu_su_69_150","chapterId":"ch_work_lieu_su_69","textTraditional":"四年","sentenceOrder":150},{"id":"s_work_lieu_su_69_151","chapterId":"ch_work_lieu_su_69","textTraditional":"頻不部節度使和盧睹、黃皮室詳穩解里等各上所獲兵甲。","sentenceOrder":151},{"id":"s_work_lieu_su_69_152","chapterId":"ch_work_lieu_su_69","textTraditional":"姪里古部送輜重行宮。","sentenceOrder":152},{"id":"s_work_lieu_su_69_153","chapterId":"ch_work_lieu_su_69","textTraditional":"五年","sentenceOrder":153},{"id":"s_work_lieu_su_69_154","chapterId":"ch_work_lieu_su_69","textTraditional":"涅剌部節度使撒葛里有惠政，部民請留，從之。","sentenceOrder":154},{"id":"s_work_lieu_su_69_155","chapterId":"ch_work_lieu_su_69","textTraditional":"六年","sentenceOrder":155},{"id":"s_work_lieu_su_69_156","chapterId":"ch_work_lieu_su_69","textTraditional":"詔烏隈于厥部卻貢貂鼠、青鼠皮，止以馬牛入貢。","sentenceOrder":156},{"id":"s_work_lieu_su_69_157","chapterId":"ch_work_lieu_su_69","textTraditional":"以西南面招討使韓德威討河湟路違命諸蕃。","sentenceOrder":157},{"id":"s_work_lieu_su_69_158","chapterId":"ch_work_lieu_su_69","textTraditional":"九年","sentenceOrder":158},{"id":"s_work_lieu_su_69_159","chapterId":"ch_work_lieu_su_69","textTraditional":"振濟室韋、烏古部。","sentenceOrder":159},{"id":"s_work_lieu_su_69_160","chapterId":"ch_work_lieu_su_69","textTraditional":"鼻骨德來貢。","sentenceOrder":160},{"id":"s_work_lieu_su_69_161","chapterId":"ch_work_lieu_su_69","textTraditional":"十二年","sentenceOrder":161},{"id":"s_work_lieu_su_69_162","chapterId":"ch_work_lieu_su_69","textTraditional":"詔皇太妃領西北路烏古部兵。","sentenceOrder":162},{"id":"s_work_lieu_su_69_163","chapterId":"ch_work_lieu_su_69","textTraditional":"十三年","sentenceOrder":163},{"id":"s_work_lieu_su_69_164","chapterId":"ch_work_lieu_su_69","textTraditional":"鼻骨德來貢。","sentenceOrder":164},{"id":"s_work_lieu_su_69_165","chapterId":"ch_work_lieu_su_69","textTraditional":"十五年","sentenceOrder":165},{"id":"s_work_lieu_su_69_166","chapterId":"ch_work_lieu_su_69","textTraditional":"罷奚五部歲貢○鹿。","sentenceOrder":166},{"id":"s_work_lieu_su_69_167","chapterId":"ch_work_lieu_su_69","textTraditional":"敵烈八部殺詳穩以叛，蕭撻○追擊，獲其部族之半。","sentenceOrder":167},{"id":"s_work_lieu_su_69_168","chapterId":"ch_work_lieu_su_69","textTraditional":"罷奚王諸部貢物。","sentenceOrder":168},{"id":"s_work_lieu_su_69_169","chapterId":"ch_work_lieu_su_69","textTraditional":"十六年","sentenceOrder":169},{"id":"s_work_lieu_su_69_170","chapterId":"ch_work_lieu_su_69","textTraditional":"鼻骨德酋長來貢。","sentenceOrder":170},{"id":"s_work_lieu_su_69_171","chapterId":"ch_work_lieu_su_69","textTraditional":"十九年","sentenceOrder":171},{"id":"s_work_lieu_su_69_172","chapterId":"ch_work_lieu_su_69","textTraditional":"達盧骨部來貢。","sentenceOrder":172},{"id":"s_work_lieu_su_69_173","chapterId":"ch_work_lieu_su_69","textTraditional":"閏月，鼻骨德來貢。","sentenceOrder":173},{"id":"s_work_lieu_su_69_174","chapterId":"ch_work_lieu_su_69","textTraditional":"二十一年","sentenceOrder":174},{"id":"s_work_lieu_su_69_175","chapterId":"ch_work_lieu_su_69","textTraditional":"奧里等部來貢。","sentenceOrder":175},{"id":"s_work_lieu_su_69_176","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古來貢。","sentenceOrder":176},{"id":"s_work_lieu_su_69_177","chapterId":"ch_work_lieu_su_69","textTraditional":"二十二年","sentenceOrder":177},{"id":"s_work_lieu_su_69_178","chapterId":"ch_work_lieu_su_69","textTraditional":"罷蕃部賀千齡節及冬至、重五進貢。","sentenceOrder":178},{"id":"s_work_lieu_su_69_179","chapterId":"ch_work_lieu_su_69","textTraditional":"蒲奴里、剖阿里等部來貢。","sentenceOrder":179},{"id":"s_work_lieu_su_69_180","chapterId":"ch_work_lieu_su_69","textTraditional":"二十三年","sentenceOrder":180},{"id":"s_work_lieu_su_69_181","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古來貢。","sentenceOrder":181},{"id":"s_work_lieu_su_69_182","chapterId":"ch_work_lieu_su_69","textTraditional":"鼻骨德來貢。","sentenceOrder":182},{"id":"s_work_lieu_su_69_183","chapterId":"ch_work_lieu_su_69","textTraditional":"開泰元年","sentenceOrder":183},{"id":"s_work_lieu_su_69_184","chapterId":"ch_work_lieu_su_69","textTraditional":"曷蘇館大王曷里喜來朝。","sentenceOrder":184},{"id":"s_work_lieu_su_69_185","chapterId":"ch_work_lieu_su_69","textTraditional":"二年","sentenceOrder":185},{"id":"s_work_lieu_su_69_186","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古、敵烈叛，命右皮室詳穩延壽率兵討之。","sentenceOrder":186},{"id":"s_work_lieu_su_69_187","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古、敵烈皆復故地。","sentenceOrder":187},{"id":"s_work_lieu_su_69_188","chapterId":"ch_work_lieu_su_69","textTraditional":"三年","sentenceOrder":188},{"id":"s_work_lieu_su_69_189","chapterId":"ch_work_lieu_su_69","textTraditional":"鐵驪來貢。","sentenceOrder":189},{"id":"s_work_lieu_su_69_190","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古叛。","sentenceOrder":190},{"id":"s_work_lieu_su_69_191","chapterId":"ch_work_lieu_su_69","textTraditional":"八部敵烈殺共詳穩稍瓦，皆叛，詔南府宰相耶律吾剌葛招撫之。釋所囚敵烈數人，令招諭其眾。壬子，耶律世良遣使獻敵烈之俘。","sentenceOrder":191},{"id":"s_work_lieu_su_69_192","chapterId":"ch_work_lieu_su_69","textTraditional":"四年","sentenceOrder":192},{"id":"s_work_lieu_su_69_193","chapterId":"ch_work_lieu_su_69","textTraditional":"耶律世良討敵烈得部。","sentenceOrder":193},{"id":"s_work_lieu_su_69_194","chapterId":"ch_work_lieu_su_69","textTraditional":"耶律世良討叛命烏古，盡殺之。遣使賞軍前有功將校。","sentenceOrder":194},{"id":"s_work_lieu_su_69_195","chapterId":"ch_work_lieu_su_69","textTraditional":"以旗鼓拽剌詳穩題裡姑為六部奚王。","sentenceOrder":195},{"id":"s_work_lieu_su_69_196","chapterId":"ch_work_lieu_su_69","textTraditional":"五年","sentenceOrder":196},{"id":"s_work_lieu_su_69_197","chapterId":"ch_work_lieu_su_69","textTraditional":"鼻骨德酋長撒保特、賽剌等來貢。","sentenceOrder":197},{"id":"s_work_lieu_su_69_198","chapterId":"ch_work_lieu_su_69","textTraditional":"七年","sentenceOrder":198},{"id":"s_work_lieu_su_69_199","chapterId":"ch_work_lieu_su_69","textTraditional":"命東北越里篤、部阿里、奧里米、蒲奴里、鐵驪等五部歲貢貂皮六萬五千，馬三百匹。","sentenceOrder":199},{"id":"s_work_lieu_su_69_200","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古部節度使蕭普達討叛命敵烈，滅之。","sentenceOrder":200},{"id":"s_work_lieu_su_69_201","chapterId":"ch_work_lieu_su_69","textTraditional":"蒲奴里部來貢。","sentenceOrder":201},{"id":"s_work_lieu_su_69_202","chapterId":"ch_work_lieu_su_69","textTraditional":"八年","sentenceOrder":202},{"id":"s_work_lieu_su_69_203","chapterId":"ch_work_lieu_su_69","textTraditional":"回跋部太師踏剌葛來貢。","sentenceOrder":203},{"id":"s_work_lieu_su_69_204","chapterId":"ch_work_lieu_su_69","textTraditional":"曷蘇館惕隱阿不葛、宰相賽剌來貢。","sentenceOrder":204},{"id":"s_work_lieu_su_69_205","chapterId":"ch_work_lieu_su_69","textTraditional":"回跋部太保麻門來貢。","sentenceOrder":205},{"id":"s_work_lieu_su_69_206","chapterId":"ch_work_lieu_su_69","textTraditional":"曷蘇館惕隱阿不葛來貢。","sentenceOrder":206},{"id":"s_work_lieu_su_69_207","chapterId":"ch_work_lieu_su_69","textTraditional":"太平元年","sentenceOrder":207},{"id":"s_work_lieu_su_69_208","chapterId":"ch_work_lieu_su_69","textTraditional":"敵烈酋長頗白來貢馬、駝。","sentenceOrder":208},{"id":"s_work_lieu_su_69_209","chapterId":"ch_work_lieu_su_69","textTraditional":"六年","sentenceOrder":209},{"id":"s_work_lieu_su_69_210","chapterId":"ch_work_lieu_su_69","textTraditional":"蒲盧毛朵部內多有兀惹民戶，詔索之。","sentenceOrder":210},{"id":"s_work_lieu_su_69_211","chapterId":"ch_work_lieu_su_69","textTraditional":"朮不姑諸部皆叛。","sentenceOrder":211},{"id":"s_work_lieu_su_69_212","chapterId":"ch_work_lieu_su_69","textTraditional":"曷蘇館諸部長來朝。","sentenceOrder":212},{"id":"s_work_lieu_su_69_213","chapterId":"ch_work_lieu_su_69","textTraditional":"曷蘇館部乞建旗鼓，許之。","sentenceOrder":213},{"id":"s_work_lieu_su_69_214","chapterId":"ch_work_lieu_su_69","textTraditional":"七年","sentenceOrder":214},{"id":"s_work_lieu_su_69_215","chapterId":"ch_work_lieu_su_69","textTraditional":"蒲盧毛朵部遣使來貢。","sentenceOrder":215},{"id":"s_work_lieu_su_69_216","chapterId":"ch_work_lieu_su_69","textTraditional":"女直部、蒲盧毛朵部送來州收管。","sentenceOrder":216},{"id":"s_work_lieu_su_69_217","chapterId":"ch_work_lieu_su_69","textTraditional":"查只底部民四百戶來附。","sentenceOrder":217},{"id":"s_work_lieu_su_69_218","chapterId":"ch_work_lieu_su_69","textTraditional":"興宗","sentenceOrder":218},{"id":"s_work_lieu_su_69_219","chapterId":"ch_work_lieu_su_69","textTraditional":"重熙元年","sentenceOrder":219},{"id":"s_work_lieu_su_69_220","chapterId":"ch_work_lieu_su_69","textTraditional":"五國酋長來貢。","sentenceOrder":220},{"id":"s_work_lieu_su_69_221","chapterId":"ch_work_lieu_su_69","textTraditional":"三年","sentenceOrder":221},{"id":"s_work_lieu_su_69_222","chapterId":"ch_work_lieu_su_69","textTraditional":"振濟耶迷只部。","sentenceOrder":222},{"id":"s_work_lieu_su_69_223","chapterId":"ch_work_lieu_su_69","textTraditional":"十年","sentenceOrder":223},{"id":"s_work_lieu_su_69_224","chapterId":"ch_work_lieu_su_69","textTraditional":"曷蘇館人戶沒入蒲盧毛朵部者，索還復業。","sentenceOrder":224},{"id":"s_work_lieu_su_69_225","chapterId":"ch_work_lieu_su_69","textTraditional":"朮不姑酋長來貢。","sentenceOrder":225},{"id":"s_work_lieu_su_69_226","chapterId":"ch_work_lieu_su_69","textTraditional":"十二年","sentenceOrder":226},{"id":"s_work_lieu_su_69_227","chapterId":"ch_work_lieu_su_69","textTraditional":"置回跋部詳穩、都監。","sentenceOrder":227},{"id":"s_work_lieu_su_69_228","chapterId":"ch_work_lieu_su_69","textTraditional":"以斡朵、蒲盧毛朵部二使來貢不時，釋其罪，遣之。","sentenceOrder":228},{"id":"s_work_lieu_su_69_229","chapterId":"ch_work_lieu_su_69","textTraditional":"十三年","sentenceOrder":229},{"id":"s_work_lieu_su_69_230","chapterId":"ch_work_lieu_su_69","textTraditional":"耶律歐里斯將兵攻蒲盧毛朵部。西南面招討都監羅漢奴、詳穩斡魯母等奏山西部族節度使屈烈以五部叛入西夏，仍乞南北府兵援送實威塞州人戶。詔選富者發之，餘令屯田於天德軍。","sentenceOrder":230},{"id":"s_work_lieu_su_69_231","chapterId":"ch_work_lieu_su_69","textTraditional":"羅漢奴奏所發部兵與党項戰不利。","sentenceOrder":231},{"id":"s_work_lieu_su_69_232","chapterId":"ch_work_lieu_su_69","textTraditional":"元昊率党項三部酋長來降。","sentenceOrder":232},{"id":"s_work_lieu_su_69_233","chapterId":"ch_work_lieu_su_69","textTraditional":"十五年","sentenceOrder":233},{"id":"s_work_lieu_su_69_234","chapterId":"ch_work_lieu_su_69","textTraditional":"蒲盧毛朵界曷懶河人戶來附。","sentenceOrder":234},{"id":"s_work_lieu_su_69_235","chapterId":"ch_work_lieu_su_69","textTraditional":"蒲盧毛朵曷懶河一百八十戶來附。","sentenceOrder":235},{"id":"s_work_lieu_su_69_236","chapterId":"ch_work_lieu_su_69","textTraditional":"女直部長遮母率眾來附。","sentenceOrder":236},{"id":"s_work_lieu_su_69_237","chapterId":"ch_work_lieu_su_69","textTraditional":"十七年","sentenceOrder":237},{"id":"s_work_lieu_su_69_238","chapterId":"ch_work_lieu_su_69","textTraditional":"振濟瑤穩、嘲穩部。","sentenceOrder":238},{"id":"s_work_lieu_su_69_239","chapterId":"ch_work_lieu_su_69","textTraditional":"蒲盧毛朵部大王蒲輦進舡工。","sentenceOrder":239},{"id":"s_work_lieu_su_69_240","chapterId":"ch_work_lieu_su_69","textTraditional":"長白山太師柴葛、回跋太師撒剌都來貢方物。","sentenceOrder":240},{"id":"s_work_lieu_su_69_241","chapterId":"ch_work_lieu_su_69","textTraditional":"婆離八部夷離菫虎〈番去〉等內附。","sentenceOrder":241},{"id":"s_work_lieu_su_69_242","chapterId":"ch_work_lieu_su_69","textTraditional":"伐蒲奴里酋陶得里。","sentenceOrder":242},{"id":"s_work_lieu_su_69_243","chapterId":"ch_work_lieu_su_69","textTraditional":"十八年","sentenceOrder":243},{"id":"s_work_lieu_su_69_244","chapterId":"ch_work_lieu_su_69","textTraditional":"耶律義先奏蒲奴里之捷。","sentenceOrder":244},{"id":"s_work_lieu_su_69_245","chapterId":"ch_work_lieu_su_69","textTraditional":"耶律義先等執陶得里以獻。","sentenceOrder":245},{"id":"s_work_lieu_su_69_246","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古遣使送款。","sentenceOrder":246},{"id":"s_work_lieu_su_69_247","chapterId":"ch_work_lieu_su_69","textTraditional":"五國酋長各率其部來附。回跋部長兀迭、臺札等來朝。五國節度使耶律仙童以降烏古叛人，授左監門衛上將軍。","sentenceOrder":247},{"id":"s_work_lieu_su_69_248","chapterId":"ch_work_lieu_su_69","textTraditional":"十九年","sentenceOrder":248},{"id":"s_work_lieu_su_69_249","chapterId":"ch_work_lieu_su_69","textTraditional":"蒲盧毛朵部惕隱信篤來貢。","sentenceOrder":249},{"id":"s_work_lieu_su_69_250","chapterId":"ch_work_lieu_su_69","textTraditional":"高麗來貢。","sentenceOrder":250},{"id":"s_work_lieu_su_69_251","chapterId":"ch_work_lieu_su_69","textTraditional":"遠夷拔思母部遣使來貢。","sentenceOrder":251},{"id":"s_work_lieu_su_69_252","chapterId":"ch_work_lieu_su_69","textTraditional":"回跋、曷蘇館、蒲盧毛朵部各遣使進馬。","sentenceOrder":252},{"id":"s_work_lieu_su_69_253","chapterId":"ch_work_lieu_su_69","textTraditional":"二十一年","sentenceOrder":253},{"id":"s_work_lieu_su_69_254","chapterId":"ch_work_lieu_su_69","textTraditional":"遣使詣五國及鼻骨德、烏古、敵烈四部捕海東青鶻。","sentenceOrder":254},{"id":"s_work_lieu_su_69_255","chapterId":"ch_work_lieu_su_69","textTraditional":"道宗","sentenceOrder":255},{"id":"s_work_lieu_su_69_256","chapterId":"ch_work_lieu_su_69","textTraditional":"清寧二年","sentenceOrder":256},{"id":"s_work_lieu_su_69_257","chapterId":"ch_work_lieu_su_69","textTraditional":"詔二女古部與世預宰相、節度使之選者，免皮室軍役。","sentenceOrder":257},{"id":"s_work_lieu_su_69_258","chapterId":"ch_work_lieu_su_69","textTraditional":"三年","sentenceOrder":258},{"id":"s_work_lieu_su_69_259","chapterId":"ch_work_lieu_su_69","textTraditional":"五國部長貢方物。","sentenceOrder":259},{"id":"s_work_lieu_su_69_260","chapterId":"ch_work_lieu_su_69","textTraditional":"八年","sentenceOrder":260},{"id":"s_work_lieu_su_69_261","chapterId":"ch_work_lieu_su_69","textTraditional":"吾獨婉惕隱屯禿葛等乞歲貢馬、駝，許之。","sentenceOrder":261},{"id":"s_work_lieu_su_69_262","chapterId":"ch_work_lieu_su_69","textTraditional":"咸雍五年","sentenceOrder":262},{"id":"s_work_lieu_su_69_263","chapterId":"ch_work_lieu_su_69","textTraditional":"五國剖阿里部叛命，左夷離畢蕭素颯討之。","sentenceOrder":263},{"id":"s_work_lieu_su_69_264","chapterId":"ch_work_lieu_su_69","textTraditional":"五國酋長來降，仍獻方物。","sentenceOrder":264},{"id":"s_work_lieu_su_69_265","chapterId":"ch_work_lieu_su_69","textTraditional":"六年","sentenceOrder":265},{"id":"s_work_lieu_su_69_266","chapterId":"ch_work_lieu_su_69","textTraditional":"五國部長來朝。","sentenceOrder":266},{"id":"s_work_lieu_su_69_267","chapterId":"ch_work_lieu_su_69","textTraditional":"九年","sentenceOrder":267},{"id":"s_work_lieu_su_69_268","chapterId":"ch_work_lieu_su_69","textTraditional":"八石烈敵烈人殺其節度使以叛，上詔隈烏古部軍分兩道擊之。","sentenceOrder":268},{"id":"s_work_lieu_su_69_269","chapterId":"ch_work_lieu_su_69","textTraditional":"大康元年","sentenceOrder":269},{"id":"s_work_lieu_su_69_270","chapterId":"ch_work_lieu_su_69","textTraditional":"西北路叛命酋長遐搭、雛搭、雙古等來降。","sentenceOrder":270},{"id":"s_work_lieu_su_69_271","chapterId":"ch_work_lieu_su_69","textTraditional":"四年","sentenceOrder":271},{"id":"s_work_lieu_su_69_272","chapterId":"ch_work_lieu_su_69","textTraditional":"五國部長來貢。","sentenceOrder":272},{"id":"s_work_lieu_su_69_273","chapterId":"ch_work_lieu_su_69","textTraditional":"七年","sentenceOrder":273},{"id":"s_work_lieu_su_69_274","chapterId":"ch_work_lieu_su_69","textTraditional":"五國部長來貢。","sentenceOrder":274},{"id":"s_work_lieu_su_69_275","chapterId":"ch_work_lieu_su_69","textTraditional":"八年","sentenceOrder":275},{"id":"s_work_lieu_su_69_276","chapterId":"ch_work_lieu_su_69","textTraditional":"五國諸酋長貢方物。","sentenceOrder":276},{"id":"s_work_lieu_su_69_277","chapterId":"ch_work_lieu_su_69","textTraditional":"九年","sentenceOrder":277},{"id":"s_work_lieu_su_69_278","chapterId":"ch_work_lieu_su_69","textTraditional":"五國部長來貢。","sentenceOrder":278},{"id":"s_work_lieu_su_69_279","chapterId":"ch_work_lieu_su_69","textTraditional":"大安元年","sentenceOrder":279},{"id":"s_work_lieu_su_69_280","chapterId":"ch_work_lieu_su_69","textTraditional":"五國酋長來貢良馬。","sentenceOrder":280},{"id":"s_work_lieu_su_69_281","chapterId":"ch_work_lieu_su_69","textTraditional":"三年","sentenceOrder":281},{"id":"s_work_lieu_su_69_282","chapterId":"ch_work_lieu_su_69","textTraditional":"出絹賜隗烏古部貧民。","sentenceOrder":282},{"id":"s_work_lieu_su_69_283","chapterId":"ch_work_lieu_su_69","textTraditional":"西北部渤海進牛。","sentenceOrder":283},{"id":"s_work_lieu_su_69_284","chapterId":"ch_work_lieu_su_69","textTraditional":"四年","sentenceOrder":284},{"id":"s_work_lieu_su_69_285","chapterId":"ch_work_lieu_su_69","textTraditional":"五國諸部長來貢。","sentenceOrder":285},{"id":"s_work_lieu_su_69_286","chapterId":"ch_work_lieu_su_69","textTraditional":"詔諸部官長親鞫獄訟。","sentenceOrder":286},{"id":"s_work_lieu_su_69_287","chapterId":"ch_work_lieu_su_69","textTraditional":"八年","sentenceOrder":287},{"id":"s_work_lieu_su_69_288","chapterId":"ch_work_lieu_su_69","textTraditional":"阻卜酋長磨古斯殺金吾吐古斯以叛，遣奚六部吐里耶律郭三發諸蕃部兵討之。","sentenceOrder":288},{"id":"s_work_lieu_su_69_289","chapterId":"ch_work_lieu_su_69","textTraditional":"九年","sentenceOrder":289},{"id":"s_work_lieu_su_69_290","chapterId":"ch_work_lieu_su_69","textTraditional":"詔以戰馬三千給烏古部。烏古敵烈統軍使蕭朽哥奏討阻卜之捷。","sentenceOrder":290},{"id":"s_work_lieu_su_69_291","chapterId":"ch_work_lieu_su_69","textTraditional":"十年","sentenceOrder":291},{"id":"s_work_lieu_su_69_292","chapterId":"ch_work_lieu_su_69","textTraditional":"惕德酋長來貢。","sentenceOrder":292},{"id":"s_work_lieu_su_69_293","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古部節度使耶律陳家奴奏討茶札剌之捷。知北院樞密使事耶律斡特剌為都統，夷離畢耶律禿朵為副統，龍虎衛上將軍耶律胡呂為都監，討磨古斯，遣積慶宮使蕭糾里監戰。","sentenceOrder":293},{"id":"s_work_lieu_su_69_294","chapterId":"ch_work_lieu_su_69","textTraditional":"西北路招討司奏敵烈部入寇，統軍司兵與戰不利，招討司兵擊破之。","sentenceOrder":294},{"id":"s_work_lieu_su_69_295","chapterId":"ch_work_lieu_su_69","textTraditional":"和烈葛部來貢。惕德酋長來貢。","sentenceOrder":295},{"id":"s_work_lieu_su_69_296","chapterId":"ch_work_lieu_su_69","textTraditional":"是歲，惕德酋長萌得斯領所部來降，詔復舊地。頗裡八部來寇，擊敗之。","sentenceOrder":296},{"id":"s_work_lieu_su_69_297","chapterId":"ch_work_lieu_su_69","textTraditional":"壽降元年","sentenceOrder":297},{"id":"s_work_lieu_su_69_298","chapterId":"ch_work_lieu_su_69","textTraditional":"敵烈入寇，掠群牧馬，戍兵襲之，盡得所掠。","sentenceOrder":298},{"id":"s_work_lieu_su_69_299","chapterId":"ch_work_lieu_su_69","textTraditional":"斡特剌奏耶睹刮之捷。","sentenceOrder":299},{"id":"s_work_lieu_su_69_300","chapterId":"ch_work_lieu_su_69","textTraditional":"頗里八部酋長來附，且進方物。斡特剌奏磿古斯之捷。","sentenceOrder":300},{"id":"s_work_lieu_su_69_301","chapterId":"ch_work_lieu_su_69","textTraditional":"二年","sentenceOrder":301},{"id":"s_work_lieu_su_69_302","chapterId":"ch_work_lieu_su_69","textTraditional":"市牛以給烏古、敵烈、隗烏古部貧民。","sentenceOrder":302},{"id":"s_work_lieu_su_69_303","chapterId":"ch_work_lieu_su_69","textTraditional":"振撻麻里別古部。","sentenceOrder":303},{"id":"s_work_lieu_su_69_304","chapterId":"ch_work_lieu_su_69","textTraditional":"頗里八部進馬。","sentenceOrder":304},{"id":"s_work_lieu_su_69_305","chapterId":"ch_work_lieu_su_69","textTraditional":"三年","sentenceOrder":305},{"id":"s_work_lieu_su_69_306","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古部節度使耶律陳家奴討西北諸部有功。","sentenceOrder":306},{"id":"s_work_lieu_su_69_307","chapterId":"ch_work_lieu_su_69","textTraditional":"蒲盧毛朵部長率其部民來歸。","sentenceOrder":307},{"id":"s_work_lieu_su_69_308","chapterId":"ch_work_lieu_su_69","textTraditional":"五國部長來貢。","sentenceOrder":308},{"id":"s_work_lieu_su_69_309","chapterId":"ch_work_lieu_su_69","textTraditional":"蒲盧毛朵部來貢。","sentenceOrder":309},{"id":"s_work_lieu_su_69_310","chapterId":"ch_work_lieu_su_69","textTraditional":"五年","sentenceOrder":310},{"id":"s_work_lieu_su_69_311","chapterId":"ch_work_lieu_su_69","textTraditional":"五國部長來貢。","sentenceOrder":311},{"id":"s_work_lieu_su_69_312","chapterId":"ch_work_lieu_su_69","textTraditional":"惕德酋長禿的等來貢。","sentenceOrder":312},{"id":"s_work_lieu_su_69_313","chapterId":"ch_work_lieu_su_69","textTraditional":"斡特剌奏討耶睹刮之捷。","sentenceOrder":313},{"id":"s_work_lieu_su_69_314","chapterId":"ch_work_lieu_su_69","textTraditional":"六年","sentenceOrder":314},{"id":"s_work_lieu_su_69_315","chapterId":"ch_work_lieu_su_69","textTraditional":"斡特剌獲叛命磨古斯來獻。","sentenceOrder":315},{"id":"s_work_lieu_su_69_316","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古部討茶札剌，破之。","sentenceOrder":316},{"id":"s_work_lieu_su_69_317","chapterId":"ch_work_lieu_su_69","textTraditional":"耶睹刮諸部寇西北路。","sentenceOrder":317},{"id":"s_work_lieu_su_69_318","chapterId":"ch_work_lieu_su_69","textTraditional":"斡特剌奏耶睹刮諸部之捷。","sentenceOrder":318},{"id":"s_work_lieu_su_69_319","chapterId":"ch_work_lieu_su_69","textTraditional":"五國諸部長來貢。","sentenceOrder":319},{"id":"s_work_lieu_su_69_320","chapterId":"ch_work_lieu_su_69","textTraditional":"天祚","sentenceOrder":320},{"id":"s_work_lieu_su_69_321","chapterId":"ch_work_lieu_su_69","textTraditional":"乾統二年","sentenceOrder":321},{"id":"s_work_lieu_su_69_322","chapterId":"ch_work_lieu_su_69","textTraditional":"斡特剌獻耶睹刮等部之捷。","sentenceOrder":322},{"id":"s_work_lieu_su_69_323","chapterId":"ch_work_lieu_su_69","textTraditional":"四年","sentenceOrder":323},{"id":"s_work_lieu_su_69_324","chapterId":"ch_work_lieu_su_69","textTraditional":"鼻骨德遣使來貢。","sentenceOrder":324},{"id":"s_work_lieu_su_69_325","chapterId":"ch_work_lieu_su_69","textTraditional":"九年","sentenceOrder":325},{"id":"s_work_lieu_su_69_326","chapterId":"ch_work_lieu_su_69","textTraditional":"五國部來貢。","sentenceOrder":326},{"id":"s_work_lieu_su_69_327","chapterId":"ch_work_lieu_su_69","textTraditional":"十年","sentenceOrder":327},{"id":"s_work_lieu_su_69_328","chapterId":"ch_work_lieu_su_69","textTraditional":"五國部長來貢。","sentenceOrder":328},{"id":"s_work_lieu_su_69_329","chapterId":"ch_work_lieu_su_69","textTraditional":"天慶元年","sentenceOrder":329},{"id":"s_work_lieu_su_69_330","chapterId":"ch_work_lieu_su_69","textTraditional":"五國部長來貢。","sentenceOrder":330},{"id":"s_work_lieu_su_69_331","chapterId":"ch_work_lieu_su_69","textTraditional":"二年","sentenceOrder":331},{"id":"s_work_lieu_su_69_332","chapterId":"ch_work_lieu_su_69","textTraditional":"五國部長來貢。","sentenceOrder":332},{"id":"s_work_lieu_su_69_333","chapterId":"ch_work_lieu_su_69","textTraditional":"五年","sentenceOrder":333},{"id":"s_work_lieu_su_69_334","chapterId":"ch_work_lieu_su_69","textTraditional":"饒州渤海古欲等反，自稱大王，以蕭謝佛留等討之。","sentenceOrder":334},{"id":"s_work_lieu_su_69_335","chapterId":"ch_work_lieu_su_69","textTraditional":"六年","sentenceOrder":335},{"id":"s_work_lieu_su_69_336","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古部叛，遣中丞耶律撻不也等招之。","sentenceOrder":336},{"id":"s_work_lieu_su_69_337","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古部降。","sentenceOrder":337},{"id":"s_work_lieu_su_69_338","chapterId":"ch_work_lieu_su_69","textTraditional":"東面行軍副統馬哥、余睹等攻曷蘇館，敗績。","sentenceOrder":338},{"id":"s_work_lieu_su_69_339","chapterId":"ch_work_lieu_su_69","textTraditional":"保大二年","sentenceOrder":339},{"id":"s_work_lieu_su_69_340","chapterId":"ch_work_lieu_su_69","textTraditional":"金師取西京，沙漠以南部族皆降之，帝遁訛莎烈。","sentenceOrder":340},{"id":"s_work_lieu_su_69_341","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古部節度使耶律棠古破敵烈部叛命皮室，加太子太保。","sentenceOrder":341},{"id":"s_work_lieu_su_69_342","chapterId":"ch_work_lieu_su_69","textTraditional":"都統馬哥討叛命敵烈部，克之。","sentenceOrder":342},{"id":"s_work_lieu_su_69_343","chapterId":"ch_work_lieu_su_69","textTraditional":"聞金主撫定南京，遂由掃里關出，居四部族詳穩之家。","sentenceOrder":343},{"id":"s_work_lieu_su_69_344","chapterId":"ch_work_lieu_su_69","textTraditional":"三年","sentenceOrder":344},{"id":"s_work_lieu_su_69_345","chapterId":"ch_work_lieu_su_69","textTraditional":"軍將耶律敵烈等刧梁王雅里奔西北部。","sentenceOrder":345},{"id":"s_work_lieu_su_69_346","chapterId":"ch_work_lieu_su_69","textTraditional":"耶律大石自金朝亡歸。復渡河東還，居突呂不部。","sentenceOrder":346},{"id":"s_work_lieu_su_69_347","chapterId":"ch_work_lieu_su_69","textTraditional":"四年","sentenceOrder":347},{"id":"s_work_lieu_su_69_348","chapterId":"ch_work_lieu_su_69","textTraditional":"上北遁，謨葛失來迎，率部人防衛。時侍從乏糧數日，以衣易羊。至烏古敵烈部，封謨葛失為神于越。","sentenceOrder":348},{"id":"s_work_lieu_su_69_349","chapterId":"ch_work_lieu_su_69","textTraditional":"上納突呂不部人訛哥之妻諳葛，以訛葛為本部節度使。","sentenceOrder":349},{"id":"s_work_lieu_su_69_350","chapterId":"ch_work_lieu_su_69","textTraditional":"天祚播越，耶律大石立燕晉國王淳；淳死，與蕭妃奔天德軍。上誅妃，責大石。大石率眾西去，自立為帝。所歷諸部，附見於後：","sentenceOrder":350},{"id":"s_work_lieu_su_69_351","chapterId":"ch_work_lieu_su_69","textTraditional":"大黃室韋部","sentenceOrder":351},{"id":"s_work_lieu_su_69_352","chapterId":"ch_work_lieu_su_69","textTraditional":"白達旦部","sentenceOrder":352},{"id":"s_work_lieu_su_69_353","chapterId":"ch_work_lieu_su_69","textTraditional":"敵烈部","sentenceOrder":353},{"id":"s_work_lieu_su_69_354","chapterId":"ch_work_lieu_su_69","textTraditional":"王紀剌部","sentenceOrder":354},{"id":"s_work_lieu_su_69_355","chapterId":"ch_work_lieu_su_69","textTraditional":"茶赤剌部","sentenceOrder":355},{"id":"s_work_lieu_su_69_356","chapterId":"ch_work_lieu_su_69","textTraditional":"也喜部","sentenceOrder":356},{"id":"s_work_lieu_su_69_357","chapterId":"ch_work_lieu_su_69","textTraditional":"鼻骨德部","sentenceOrder":357},{"id":"s_work_lieu_su_69_358","chapterId":"ch_work_lieu_su_69","textTraditional":"尼剌部","sentenceOrder":358},{"id":"s_work_lieu_su_69_359","chapterId":"ch_work_lieu_su_69","textTraditional":"達剌乖部","sentenceOrder":359},{"id":"s_work_lieu_su_69_360","chapterId":"ch_work_lieu_su_69","textTraditional":"達密里部","sentenceOrder":360},{"id":"s_work_lieu_su_69_361","chapterId":"ch_work_lieu_su_69","textTraditional":"密兒紀部","sentenceOrder":361},{"id":"s_work_lieu_su_69_362","chapterId":"ch_work_lieu_su_69","textTraditional":"合主部","sentenceOrder":362},{"id":"s_work_lieu_su_69_363","chapterId":"ch_work_lieu_su_69","textTraditional":"烏古里部","sentenceOrder":363},{"id":"s_work_lieu_su_69_364","chapterId":"ch_work_lieu_su_69","textTraditional":"阻卜部","sentenceOrder":364},{"id":"s_work_lieu_su_69_365","chapterId":"ch_work_lieu_su_69","textTraditional":"普速完部","sentenceOrder":365},{"id":"s_work_lieu_su_69_366","chapterId":"ch_work_lieu_su_69","textTraditional":"唐古部","sentenceOrder":366},{"id":"s_work_lieu_su_69_367","chapterId":"ch_work_lieu_su_69","textTraditional":"忽母思部","sentenceOrder":367},{"id":"s_work_lieu_su_69_368","chapterId":"ch_work_lieu_su_6