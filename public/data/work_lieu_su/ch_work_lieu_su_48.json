entenceOrder":242},{"id":"s_work_lieu_su_48_243","chapterId":"ch_work_lieu_su_48","textTraditional":"安州團練使。","sentenceOrder":243},{"id":"s_work_lieu_su_48_244","chapterId":"ch_work_lieu_su_48","textTraditional":"防禦使司職名總目：","sentenceOrder":244},{"id":"s_work_lieu_su_48_245","chapterId":"ch_work_lieu_su_48","textTraditional":"某州防禦使。","sentenceOrder":245},{"id":"s_work_lieu_su_48_246","chapterId":"ch_work_lieu_su_48","textTraditional":"某州防禦副使。","sentenceOrder":246},{"id":"s_work_lieu_su_48_247","chapterId":"ch_work_lieu_su_48","textTraditional":"某州防禦判官。","sentenceOrder":247},{"id":"s_work_lieu_su_48_248","chapterId":"ch_work_lieu_su_48","textTraditional":"州學。","sentenceOrder":248},{"id":"s_work_lieu_su_48_249","chapterId":"ch_work_lieu_su_48","textTraditional":"博士。","sentenceOrder":249},{"id":"s_work_lieu_su_48_250","chapterId":"ch_work_lieu_su_48","textTraditional":"助教。","sentenceOrder":250},{"id":"s_work_lieu_su_48_251","chapterId":"ch_work_lieu_su_48","textTraditional":"東京道：","sentenceOrder":251},{"id":"s_work_lieu_su_48_252","chapterId":"ch_work_lieu_su_48","textTraditional":"廣州防禦使司。","sentenceOrder":252},{"id":"s_work_lieu_su_48_253","chapterId":"ch_work_lieu_su_48","textTraditional":"鎮海府防禦使司。","sentenceOrder":253},{"id":"s_work_lieu_su_48_254","chapterId":"ch_work_lieu_su_48","textTraditional":"冀州防禦使司。","sentenceOrder":254},{"id":"s_work_lieu_su_48_255","chapterId":"ch_work_lieu_su_48","textTraditional":"衍州安廣軍防禦使司。","sentenceOrder":255},{"id":"s_work_lieu_su_48_256","chapterId":"ch_work_lieu_su_48","textTraditional":"州刺史職名總目：","sentenceOrder":256},{"id":"s_work_lieu_su_48_257","chapterId":"ch_work_lieu_su_48","textTraditional":"某州刺史。","sentenceOrder":257},{"id":"s_work_lieu_su_48_258","chapterId":"ch_work_lieu_su_48","textTraditional":"某州同知州事。耶律獨攧，重熙中同知金肅軍事。","sentenceOrder":258},{"id":"s_work_lieu_su_48_259","chapterId":"ch_work_lieu_su_48","textTraditional":"某州錄事參軍。世宗天祿五年，詔州錄事參軍委政事省差注。","sentenceOrder":259},{"id":"s_work_lieu_su_48_260","chapterId":"ch_work_lieu_su_48","textTraditional":"州學。","sentenceOrder":260},{"id":"s_work_lieu_su_48_261","chapterId":"ch_work_lieu_su_48","textTraditional":"博士。","sentenceOrder":261},{"id":"s_work_lieu_su_48_262","chapterId":"ch_work_lieu_su_48","textTraditional":"助教。","sentenceOrder":262},{"id":"s_work_lieu_su_48_263","chapterId":"ch_work_lieu_su_48","textTraditional":"上京道五州：烏、降聖、維、防、招。","sentenceOrder":263},{"id":"s_work_lieu_su_48_264","chapterId":"ch_work_lieu_su_48","textTraditional":"東京道三十七州：穆、賀、盧、鐵、崇、耀、嬪、遼西、康、宗、海北、巖、集、祺、遂、韓、銀、安遠、威、清、雍、湖、渤、郢、銅、涑、率賓、定理、鐵利、吉、麓、荊、勝、順化、連、肅、烏。","sentenceOrder":264},{"id":"s_work_lieu_su_48_265","chapterId":"ch_work_lieu_su_48","textTraditional":"中京道十三州：恩、惠、榆、澤、北安、潭、松山、安德、黔、嚴、隰、遷、潤。","sentenceOrder":265},{"id":"s_work_lieu_su_48_266","chapterId":"ch_work_lieu_su_48","textTraditional":"南京道八州：順、檀、涿、易、薊、景、灤、營。","sentenceOrder":266},{"id":"s_work_lieu_su_48_267","chapterId":"ch_work_lieu_su_48","textTraditional":"西京道八州：弘、德、寧邊、歸化、可汗、儒、武、東勝。","sentenceOrder":267},{"id":"s_work_lieu_su_48_268","chapterId":"ch_work_lieu_su_48","textTraditional":"縣職名總目：","sentenceOrder":268},{"id":"s_work_lieu_su_48_269","chapterId":"ch_work_lieu_su_48","textTraditional":"某縣令。","sentenceOrder":269},{"id":"s_work_lieu_su_48_270","chapterId":"ch_work_lieu_su_48","textTraditional":"某縣丞。","sentenceOrder":270},{"id":"s_work_lieu_su_48_271","chapterId":"ch_work_lieu_su_48","textTraditional":"某縣主簿。世宗天祿五年，詔縣主簿委政事省差注。","sentenceOrder":271},{"id":"s_work_lieu_su_48_272","chapterId":"ch_work_lieu_su_48","textTraditional":"某縣尉。","sentenceOrder":272},{"id":"s_work_lieu_su_48_273","chapterId":"ch_work_lieu_su_48","textTraditional":"縣學。大公鼎為良鄉縣尹，建孔子廟。","sentenceOrder":273},{"id":"s_work_lieu_su_48_274","chapterId":"ch_work_lieu_su_48","textTraditional":"博士。","sentenceOrder":274},{"id":"s_work_lieu_su_48_275","chapterId":"ch_work_lieu_su_48","textTraditional":"助教。","sentenceOrder":275},{"id":"s_work_lieu_su_48_276","chapterId":"ch_work_lieu_su_48","textTraditional":"五京諸州屬縣，見地理志。縣有驛遞、馬牛、旗鼓、鄉正、廳隸、倉司等役。有破產不能給者，良民患之。馬人望設法，使民出錢免役，官自募人，倉司給使以公使充，人以為便。","sentenceOrder":276},{"id":"s_work_lieu_su_48_277","chapterId":"ch_work_lieu_su_48","textTraditional":"南面分司官","sentenceOrder":277},{"id":"s_work_lieu_su_48_278","chapterId":"ch_work_lieu_su_48","textTraditional":"平理庶獄，採摭民隱，漢、唐以來，賢主以為恤民之令典。官不常設，有詔，則選材望官為之。","sentenceOrder":278},{"id":"s_work_lieu_su_48_279","chapterId":"ch_work_lieu_su_48","textTraditional":"分決諸道滯獄使。聖宗統和九年，命邢抱朴等五員，又命馬守瑛等三員，分決諸道滯獄。","sentenceOrder":279},{"id":"s_work_lieu_su_48_280","chapterId":"ch_work_lieu_su_48","textTraditional":"按察諸道刑獄使。開泰五年遣劉涇等分路按察刑獄。","sentenceOrder":280},{"id":"s_work_lieu_su_48_281","chapterId":"ch_work_lieu_su_48","textTraditional":"採訪使。太宗會同三年命于骨鄰為採訪使。","sentenceOrder":281},{"id":"s_work_lieu_su_48_282","chapterId":"ch_work_lieu_su_48","textTraditional":"南面財賦官","sentenceOrder":282},{"id":"s_work_lieu_su_48_283","chapterId":"ch_work_lieu_su_48","textTraditional":"遼國以畜牧、田漁為稼穡，財賦之官，初甚簡易。自涅里教耕織，而後鹽鐵諸利日以滋殖，既得燕、代，益富饒矣。","sentenceOrder":283},{"id":"s_work_lieu_su_48_284","chapterId":"ch_work_lieu_su_48","textTraditional":"諸錢帛司職名總目：","sentenceOrder":284},{"id":"s_work_lieu_su_48_285","chapterId":"ch_work_lieu_su_48","textTraditional":"某州錢帛都點檢。大公鼎為長春州錢帛都提點。","sentenceOrder":285},{"id":"s_work_lieu_su_48_286","chapterId":"ch_work_lieu_su_48","textTraditional":"長春路錢帛司。興宗重熙二十二年置。","sentenceOrder":286},{"id":"s_work_lieu_su_48_287","chapterId":"ch_work_lieu_su_48","textTraditional":"遼西路錢帛司。","sentenceOrder":287},{"id":"s_work_lieu_su_48_288","chapterId":"ch_work_lieu_su_48","textTraditional":"平州路錢帛司。","sentenceOrder":288},{"id":"s_work_lieu_su_48_289","chapterId":"ch_work_lieu_su_48","textTraditional":"轉運司職名總目：","sentenceOrder":289},{"id":"s_work_lieu_su_48_290","chapterId":"ch_work_lieu_su_48","textTraditional":"某轉運使。","sentenceOrder":290},{"id":"s_work_lieu_su_48_291","chapterId":"ch_work_lieu_su_48","textTraditional":"某轉運副使。","sentenceOrder":291},{"id":"s_work_lieu_su_48_292","chapterId":"ch_work_lieu_su_48","textTraditional":"同知某轉運使。","sentenceOrder":292},{"id":"s_work_lieu_su_48_293","chapterId":"ch_work_lieu_su_48","textTraditional":"某轉運判官。","sentenceOrder":293},{"id":"s_work_lieu_su_48_294","chapterId":"ch_work_lieu_su_48","textTraditional":"山西路都轉運使司。楊晢，興宗重熙二十年為山西轉運使。","sentenceOrder":294},{"id":"s_work_lieu_su_48_295","chapterId":"ch_work_lieu_su_48","textTraditional":"奉聖州轉運使司。聖宗開泰三年置。","sentenceOrder":295},{"id":"s_work_lieu_su_48_296","chapterId":"ch_work_lieu_su_48","textTraditional":"蔚州轉運使司。","sentenceOrder":296},{"id":"s_work_lieu_su_48_297","chapterId":"ch_work_lieu_su_48","textTraditional":"應州轉運使司。","sentenceOrder":297},{"id":"s_work_lieu_su_48_298","chapterId":"ch_work_lieu_su_48","textTraditional":"朔州轉運使司。","sentenceOrder":298},{"id":"s_work_lieu_su_48_299","chapterId":"ch_work_lieu_su_48","textTraditional":"保州轉運使司。已上並開泰三年置。","sentenceOrder":299},{"id":"s_work_lieu_su_48_300","chapterId":"ch_work_lieu_su_48","textTraditional":"西山轉運使。聖宗太平三年見西山轉運使郎玄化。","sentenceOrder":300},{"id":"s_work_lieu_su_48_301","chapterId":"ch_work_lieu_su_48","textTraditional":"南面軍官","sentenceOrder":301},{"id":"s_work_lieu_su_48_302","chapterId":"ch_work_lieu_su_48","textTraditional":"傳曰：「雖楚有材，晉寔用之。」遼自太祖以來，攻掠五代、宋境，得其人，則就用之，東、北二鄙，以農以工，有事則從軍政。計之善者也。","sentenceOrder":302},{"id":"s_work_lieu_su_48_303","chapterId":"ch_work_lieu_su_48","textTraditional":"點檢司職名總目：","sentenceOrder":303},{"id":"s_work_lieu_su_48_304","chapterId":"ch_work_lieu_su_48","textTraditional":"某都點檢。穆宗應曆十六年見殿前都點檢耶律夷剌葛。","sentenceOrder":304},{"id":"s_work_lieu_su_48_305","chapterId":"ch_work_lieu_su_48","textTraditional":"某副點檢。聖宗太平六年見副點檢耶律野。","sentenceOrder":305},{"id":"s_work_lieu_su_48_306","chapterId":"ch_work_lieu_su_48","textTraditional":"同知某都點檢。道宗清寧九年見同知點檢司事耶律撻不也。","sentenceOrder":306},{"id":"s_work_lieu_su_48_307","chapterId":"ch_work_lieu_su_48","textTraditional":"點檢司。","sentenceOrder":307},{"id":"s_work_lieu_su_48_308","chapterId":"ch_work_lieu_su_48","textTraditional":"殿前都點檢司。","sentenceOrder":308},{"id":"s_work_lieu_su_48_309","chapterId":"ch_work_lieu_su_48","textTraditional":"點檢侍衛親軍馬步司。","sentenceOrder":309},{"id":"s_work_lieu_su_48_310","chapterId":"ch_work_lieu_su_48","textTraditional":"諸指揮使司職名總目：","sentenceOrder":310},{"id":"s_work_lieu_su_48_311","chapterId":"ch_work_lieu_su_48","textTraditional":"某軍都指揮使。聖宗統和二年見侍衛親軍都指揮使韓倬。","sentenceOrder":311},{"id":"s_work_lieu_su_48_312","chapterId":"ch_work_lieu_su_48","textTraditional":"某軍副指揮使。","sentenceOrder":312},{"id":"s_work_lieu_su_48_313","chapterId":"ch_work_lieu_su_48","textTraditional":"某軍都監。","sentenceOrder":313},{"id":"s_work_lieu_su_48_314","chapterId":"ch_work_lieu_su_48","textTraditional":"某軍都指揮使司。","sentenceOrder":314},{"id":"s_work_lieu_su_48_315","chapterId":"ch_work_lieu_su_48","textTraditional":"某軍副指揮使司。","sentenceOrder":315},{"id":"s_work_lieu_su_48_316","chapterId":"ch_work_lieu_su_48","textTraditional":"並同前。","sentenceOrder":316},{"id":"s_work_lieu_su_48_317","chapterId":"ch_work_lieu_su_48","textTraditional":"侍衛親軍馬步軍都指揮使司。","sentenceOrder":317},{"id":"s_work_lieu_su_48_318","chapterId":"ch_work_lieu_su_48","textTraditional":"侍衛親軍馬軍都指揮使司。","sentenceOrder":318},{"id":"s_work_lieu_su_48_319","chapterId":"ch_work_lieu_su_48","textTraditional":"侍衛親軍步軍都指揮使司。","sentenceOrder":319},{"id":"s_work_lieu_su_48_320","chapterId":"ch_work_lieu_su_48","textTraditional":"侍衛控鶴兵馬都指揮使司。","sentenceOrder":320},{"id":"s_work_lieu_su_48_321","chapterId":"ch_work_lieu_su_48","textTraditional":"侍衛漢軍兵馬都指揮使司。","sentenceOrder":321},{"id":"s_work_lieu_su_48_322","chapterId":"ch_work_lieu_su_48","textTraditional":"四軍兵馬都指揮使司。","sentenceOrder":322},{"id":"s_work_lieu_su_48_323","chapterId":"ch_work_lieu_su_48","textTraditional":"歸聖軍兵馬都指揮使司。聖宗統和五年，以宋降軍置七指揮署，左右廂，凡四十二員。七年，隸總管府。","sentenceOrder":323},{"id":"s_work_lieu_su_48_324","chapterId":"ch_work_lieu_su_48","textTraditional":"歸聖軍左廂兵馬都指揮使司。","sentenceOrder":324},{"id":"s_work_lieu_su_48_325","chapterId":"ch_work_lieu_su_48","textTraditional":"歸聖軍右廂兵馬都指揮使司。","sentenceOrder":325},{"id":"s_work_lieu_su_48_326","chapterId":"ch_work_lieu_su_48","textTraditional":"第一左廂兵馬都指揮使司。","sentenceOrder":326},{"id":"s_work_lieu_su_48_327","chapterId":"ch_work_lieu_su_48","textTraditional":"第一右廂兵馬都指揮使司。","sentenceOrder":327},{"id":"s_work_lieu_su_48_328","chapterId":"ch_work_lieu_su_48","textTraditional":"第二左廂兵馬都指揮使司。","sentenceOrder":328},{"id":"s_work_lieu_su_48_329","chapterId":"ch_work_lieu_su_48","textTraditional":"第二右廂兵馬都指揮使司。","sentenceOrder":329},{"id":"s_work_lieu_su_48_330","chapterId":"ch_work_lieu_su_48","textTraditional":"第三左廂兵馬都指揮使司。","sentenceOrder":330},{"id":"s_work_lieu_su_48_331","chapterId":"ch_work_lieu_su_48","textTraditional":"第三右廂兵馬都指揮使司。","sentenceOrder":331},{"id":"s_work_lieu_su_48_332","chapterId":"ch_work_lieu_su_48","textTraditional":"第四左廂兵馬都指揮使司。","sentenceOrder":332},{"id":"s_work_lieu_su_48_333","chapterId":"ch_work_lieu_su_48","textTraditional":"第四右廂兵馬都指揮使司。","sentenceOrder":333},{"id":"s_work_lieu_su_48_334","chapterId":"ch_work_lieu_su_48","textTraditional":"第五左廂兵馬都指揮使司。","sentenceOrder":334},{"id":"s_work_lieu_su_48_335","chapterId":"ch_work_lieu_su_48","textTraditional":"第五右廂兵馬都指揮使司。","sentenceOrder":335},{"id":"s_work_lieu_su_48_336","chapterId":"ch_work_lieu_su_48","textTraditional":"第六左廂兵馬都指揮使司。","sentenceOrder":336},{"id":"s_work_lieu_su_48_337","chapterId":"ch_work_lieu_su_48","textTraditional":"第六右廂兵馬都指揮使司。","sentenceOrder":337},{"id":"s_work_lieu_su_48_338","chapterId":"ch_work_lieu_su_48","textTraditional":"第七左廂兵馬都指揮使司。","sentenceOrder":338},{"id":"s_work_lieu_su_48_339","chapterId":"ch_work_lieu_su_48","textTraditional":"第七右廂兵馬都指揮使司。","sentenceOrder":339},{"id":"s_work_lieu_su_48_340","chapterId":"ch_work_lieu_su_48","textTraditional":"宣力軍都指揮使司。","sentenceOrder":340},{"id":"s_work_lieu_su_48_341","chapterId":"ch_work_lieu_su_48","textTraditional":"四捷軍都指揮使司。","sentenceOrder":341},{"id":"s_work_lieu_su_48_342","chapterId":"ch_work_lieu_su_48","textTraditional":"天聖軍都指揮使司。","sentenceOrder":342},{"id":"s_work_lieu_su_48_343","chapterId":"ch_work_lieu_su_48","textTraditional":"漢軍都指揮使司。","sentenceOrder":343},{"id":"s_work_lieu_su_48_344","chapterId":"ch_work_lieu_su_48","textTraditional":"諸軍都團練使職名總目：","sentenceOrder":344},{"id":"s_work_lieu_su_48_345","chapterId":"ch_work_lieu_su_48","textTraditional":"某軍都團練使。趙思溫，太祖神冊二年為漢軍都團練使。","sentenceOrder":345},{"id":"s_work_lieu_su_48_346","chapterId":"ch_work_lieu_su_48","textTraditional":"某軍團練副使。","sentenceOrder":346},{"id":"s_work_lieu_su_48_347","chapterId":"ch_work_lieu_su_48","textTraditional":"某軍團練判官。","sentenceOrder":347},{"id":"s_work_lieu_su_48_348","chapterId":"ch_work_lieu_su_48","textTraditional":"漢軍都團練使司。","sentenceOrder":348},{"id":"s_work_lieu_su_48_349","chapterId":"ch_work_lieu_su_48","textTraditional":"諸軍兵馬都總管府職名總目：","sentenceOrder":349},{"id":"s_work_lieu_su_48_350","chapterId":"ch_work_lieu_su_48","textTraditional":"某兵馬都總管。聖宗太平四年見兵馬都總管。","sentenceOrder":350},{"id":"s_work_lieu_su_48_351","chapterId":"ch_work_lieu_su_48","textTraditional":"某兵馬副總管。","sentenceOrder":351},{"id":"s_work_lieu_su_48_352","chapterId":"ch_work_lieu_su_48","textTraditional":"同知某兵馬事。","sentenceOrder":352},{"id":"s_work_lieu_su_48_353","chapterId":"ch_work_lieu_su_48","textTraditional":"某兵馬判官。","sentenceOrder":353},{"id":"s_work_lieu_su_48_354","chapterId":"ch_work_lieu_su_48","textTraditional":"兵馬都總管府。","sentenceOrder":354},{"id":"s_work_lieu_su_48_355","chapterId":"ch_work_lieu_su_48","textTraditional":"歸聖軍兵馬都總管府。","sentenceOrder":355},{"id":"s_work_lieu_su_48_356","chapterId":"ch_work_lieu_su_48","textTraditional":"南面邊防官","sentenceOrder":356},{"id":"s_work_lieu_su_48_357","chapterId":"ch_work_lieu_su_48","textTraditional":"三皇、五帝寬柔之化，澤及漢、唐。好生惡殺，習與性成。雖五代極亂，習於戰鬥者才幾人耳。宋以文勝，然遼之邊防猶重於南面，直以其地大民眾故耳。卒之親仁善鄰，桴鼓不鳴幾二百年。此遼之所以為美也歟。易州飛狐招安使司。聖宗統和二十三年改安撫使司。易州飛狐兵馬司。道宗咸雍四年改易州安撫司。易州飛狐招撫司。西南面招安使司。耶律合住，景宗保寧初為西南面招安使。巡檢使司。耶律合住，景宗保寧中為巡檢使。五州都總管府。耶律速撒，穆宗應曆初為義、霸、祥、順、聖五州都總管。山後五州都管司。聖宗統和四年見蒲奴寧為山後五州都管。五州制置使司。聖宗開泰九年見霸、建、宜、泉、錦五州制置使。三州處置使司。韓德樞，太宗時為平、灤、營三州處置使。霸州處置使司。統和二十七年廢。","sentenceOrder":357}],"overrides":{}}