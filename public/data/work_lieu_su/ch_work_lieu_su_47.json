ntenceOrder":325},{"id":"s_work_lieu_su_47_326","chapterId":"ch_work_lieu_su_47","textTraditional":"參軍。","sentenceOrder":326},{"id":"s_work_lieu_su_47_327","chapterId":"ch_work_lieu_su_47","textTraditional":"諸王文學館。","sentenceOrder":327},{"id":"s_work_lieu_su_47_328","chapterId":"ch_work_lieu_su_47","textTraditional":"諸王教授。姚景行，重熙中為燕趙國王教授。","sentenceOrder":328},{"id":"s_work_lieu_su_47_329","chapterId":"ch_work_lieu_su_47","textTraditional":"諸王伴讀。聖宗太平八年，長沙郡王宗允等奏選諸王伴讀。","sentenceOrder":329},{"id":"s_work_lieu_su_47_330","chapterId":"ch_work_lieu_su_47","textTraditional":"已上諸王府官。","sentenceOrder":330},{"id":"s_work_lieu_su_47_331","chapterId":"ch_work_lieu_su_47","textTraditional":"南面宮官","sentenceOrder":331},{"id":"s_work_lieu_su_47_332","chapterId":"ch_work_lieu_su_47","textTraditional":"漢兒行宮都部署院。亦曰南面行宮都部署司。聖宗開泰九年改左僕射。","sentenceOrder":332},{"id":"s_work_lieu_su_47_333","chapterId":"ch_work_lieu_su_47","textTraditional":"漢兒行宮都部署。開泰七年見漢兒行宮都部署石用中。","sentenceOrder":333},{"id":"s_work_lieu_su_47_334","chapterId":"ch_work_lieu_su_47","textTraditional":"漢兒行宮副部署。興宗重熙十五年見漢兒行宮副部署耶律敵烈。","sentenceOrder":334},{"id":"s_work_lieu_su_47_335","chapterId":"ch_work_lieu_su_47","textTraditional":"知南面諸行宮副部署。重熙十年見知南面諸行宮副部署耶律褭里。","sentenceOrder":335},{"id":"s_work_lieu_su_47_336","chapterId":"ch_work_lieu_su_47","textTraditional":"同知漢兒行宮都部署事。道宗大康三年見同知漢兒行宮都部署事蕭撻不也。","sentenceOrder":336},{"id":"s_work_lieu_su_47_337","chapterId":"ch_work_lieu_su_47","textTraditional":"同簽部署司事。耶律儼，大康中為同簽部署司事。","sentenceOrder":337},{"id":"s_work_lieu_su_47_338","chapterId":"ch_work_lieu_su_47","textTraditional":"都部署判官。耶律儼，咸雍中為都部署判官。","sentenceOrder":338},{"id":"s_work_lieu_su_47_339","chapterId":"ch_work_lieu_su_47","textTraditional":"十二宮南面行宮都部署司職名總目：","sentenceOrder":339},{"id":"s_work_lieu_su_47_340","chapterId":"ch_work_lieu_su_47","textTraditional":"某宮漢人行宮都部署。","sentenceOrder":340},{"id":"s_work_lieu_su_47_341","chapterId":"ch_work_lieu_su_47","textTraditional":"某宮南面副都部署。","sentenceOrder":341},{"id":"s_work_lieu_su_47_342","chapterId":"ch_work_lieu_su_47","textTraditional":"某宮同知漢人都部署。","sentenceOrder":342},{"id":"s_work_lieu_su_47_343","chapterId":"ch_work_lieu_su_47","textTraditional":"弘義宮。","sentenceOrder":343},{"id":"s_work_lieu_su_47_344","chapterId":"ch_work_lieu_su_47","textTraditional":"永興宮。","sentenceOrder":344},{"id":"s_work_lieu_su_47_345","chapterId":"ch_work_lieu_su_47","textTraditional":"積慶宮。","sentenceOrder":345},{"id":"s_work_lieu_su_47_346","chapterId":"ch_work_lieu_su_47","textTraditional":"長寧宮。","sentenceOrder":346},{"id":"s_work_lieu_su_47_347","chapterId":"ch_work_lieu_su_47","textTraditional":"延昌宮。","sentenceOrder":347},{"id":"s_work_lieu_su_47_348","chapterId":"ch_work_lieu_su_47","textTraditional":"彰愍宮。","sentenceOrder":348},{"id":"s_work_lieu_su_47_349","chapterId":"ch_work_lieu_su_47","textTraditional":"崇德宮。","sentenceOrder":349},{"id":"s_work_lieu_su_47_350","chapterId":"ch_work_lieu_su_47","textTraditional":"興聖宮。","sentenceOrder":350},{"id":"s_work_lieu_su_47_351","chapterId":"ch_work_lieu_su_47","textTraditional":"延慶宮。","sentenceOrder":351},{"id":"s_work_lieu_su_47_352","chapterId":"ch_work_lieu_su_47","textTraditional":"太和宮。","sentenceOrder":352},{"id":"s_work_lieu_su_47_353","chapterId":"ch_work_lieu_su_47","textTraditional":"永昌宮。","sentenceOrder":353},{"id":"s_work_lieu_su_47_354","chapterId":"ch_work_lieu_su_47","textTraditional":"敦睦宮。","sentenceOrder":354}],"overrides":{}}